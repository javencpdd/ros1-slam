  "/g3a_yan/move_base_params|/home/ros1-slam/ws/src/40_navigation/lite3_navigation/config/move_base_params.yaml"
  "/g3a_yan/recovery_policy|/home/ros1-slam/ws/src/40_navigation/lite3_navigation/config/recovery_policy.yaml"
  "/g3a_yan/variants/outdoor_open|/home/ros1-slam/ws/src/40_navigation/lite3_navigation/config/variants/outdoor_open.yaml"
  "/g3a_yan/variants/crowd|/home/ros1-slam/ws/src/40_navigation/lite3_navigation/config/variants/crowd.yaml"
  "/g3a_yan/variants/night|/home/ros1-slam/ws/src/40_navigation/lite3_navigation/config/variants/night.yaml"
  "/g3a_yan/faster_lio|/home/ros1-slam/ws/src/10_slam/lite3_slam/config/faster_lio_outdoor.yaml"
)
N=0; OK=0
for t in "${TARGETS[@]}"; do
  ns="${t%%|*}"; f="${t##*|}"
  N=$((N+1))
  if rosparam load "$f" "$ns" 2>/tmp/g3a_load_err.txt; then
    echo "LOAD_OK [$N]: $f  →  $ns"
    OK=$((OK+1))
  else
    echo "LOAD_FAIL [$N]: $f  →  $ns"
    cat /tmp/g3a_load_err.txt
    FAIL=$((FAIL+1))
  fi
done
echo "== load 结果：$OK/$N LOAD_OK，LOAD_FAIL=$FAIL =="

echo
echo "== [3] G3a-② 三列表核对（rosparam get，期望非空） =="
for p in /planners /controllers /recovery_behaviors; do
  echo "--- rosparam get $p ---"
  rosparam get "$p"
done
echo
echo "== [4] 独立抽查（增强复核，不替代施工方证据） =="
echo "--- C2 抽查 /g3a_yan/planner_teb/TebLocalPlannerROS/max_vel_x（期望 0.4） ---"
rosparam get /g3a_yan/planner_teb/TebLocalPlannerROS/max_vel_x
echo "--- C3 抽查 /g3a_yan/costmap_common/obstacle_layer/obstacle_range（期望 8.0） ---"
rosparam get /g3a_yan/costmap_common/obstacle_layer/obstacle_range 2>/dev/null || rosparam get /g3a_yan/costmap_common 2>/dev/null | grep -A1 -m1 "obstacle_range" || true
echo "--- 根域改名参数抽查 /planner_max_retries（期望 -1）与 /recovery_enabled（期望 False） ---"
rosparam get /planner_max_retries; rosparam get /recovery_enabled
echo "--- 根域计数（rosparam list | wc -l） ---"
rosparam list | wc -l

echo
echo "== [5] 判据④ 素材：/g3a_yan/recovery_policy/outcome_tables 四表独立复核 =="
python3 - <<'PYEOF'
import rosparam
t = rosparam.get_param('/g3a_yan/recovery_policy/outcome_tables')
expect = {'get_path': 15, 'exe_path': 19, 'recovery': 10, 'move_base': 11}
actual = {k: len(v) for k, v in t.items()}
print('四表档数实测 =', actual)
print('期望         =', expect)
print('档数精确匹配 =', actual == expect)
zeros = {k: v.get('SUCCESS') for k, v in t.items()}
print('四表 SUCCESS 实测 =', zeros, '→ 全 0：', all(x == 0 for x in zeros.values()))
print('（对照 P3a0 log：get_path FAILURE=50 / exe_path FAILURE=100 / recovery FAILURE=150 / move_base FAILURE=10：',
      t['get_path'].get('FAILURE') == 50, t['exe_path'].get('FAILURE') == 100,
      t['recovery'].get('FAILURE') == 150, t['move_base'].get('FAILURE') == 10, '）')
PYEOF
RC=$?
echo "outcome_tables 复核退出码=$RC"

echo
echo "== [6] kill master 并复核退净（红线规程） =="
PIDS=$(pgrep -u ros1-slam -f "roscore -p 11411|rosmaster|rosout" | sort -n)
echo "kill 前 PID 清单：$PIDS"
kill $PIDS 2>/dev/null
sleep 3
kill -9 $PIDS 2>/dev/null || true
echo "--- 复核 ps -u ros1-slam（期望零行） ---"
ps -u ros1-slam -o pid,cmd
echo "ps_exit=$?（1=零行）"
echo "--- 复核 roscore/rosmaster/rosout 全局 grep（期望空） ---"
ps aux | grep -E "roscore|rosmaster|rosout" | grep -v grep
echo "grep_exit=$?（1=零匹配）"
echo "--- 复核 11411 释放 ---"
ss -tlnp 2>/dev/null | grep 11411
echo "ss_exit=$?（1=已释放）"
