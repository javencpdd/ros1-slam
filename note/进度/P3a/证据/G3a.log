#!/usr/bin/env bash
# G3a 隔离自检全量（小美，2026-10-04）——以 ros1-slam 身份执行
echo "== [规程] source /home/ros1-slam/scripts/env.sh（v3 守卫在 P5 前预期触发） =="
source /home/ros1-slam/scripts/env.sh
echo "env.sh source 退出码=$?（1=守卫触发：ws/devel 不存在，P3a 阶段预期）"
echo
echo "== [规程] devel 未编译期构造环境（P2 G2 既定规程）+ 追加 ws/src =="
source /opt/ros/noetic/setup.bash
export ROS_PACKAGE_PATH="$ROS_PACKAGE_PATH:/home/ros1-slam/ws/src"
echo "ROS_PACKAGE_PATH=$ROS_PACKAGE_PATH"
echo
echo "== [隔离自检 1/2] bash /home/ros1-slam/scripts/verify/v3_isolation.sh（[1]-[8]） =="
bash /home/ros1-slam/scripts/verify/v3_isolation.sh
echo "ISOLATION_EXIT=$?"
echo
echo "== [隔离自检 2/2] [9] 独立执行（v4 §11.2 原文命令；整脚本含 [9] 重落盘归属 P6，N2） =="
echo 'find /home/ros1-slam/ws/src/40_navigation \( -name "*.cpp" -o -name "*.cc" -o -name "*.h" \)  # 期望 0 命中'
HITS=$(find /home/ros1-slam/ws/src/40_navigation \( -name "*.cpp" -o -name "*.cc" -o -name "*.h" \) 2>/dev/null)
if [ -n "$HITS" ]; then echo "命中算法源码文件："; echo "$HITS"; echo "CHECK9_EXIT=1"; else echo "（空，0 命中）"; echo "CHECK9_EXIT=0"; fi
echo
echo "== [特别盯防 1] [5] 跨模块 include 依据：全部 launch 的 'find lite3_*' 引用 vs 自身包 =="
for L in /home/ros1-slam/ws/src/*/lite3_*/launch/*.launch; do
  [ -e "$L" ] || continue
  SELF=$(basename "$(dirname "$(dirname "$L")")")
  REFS=$(grep -o 'find lite3_[a-z_]*' "$L" 2>/dev/null | sed 's/find //;s/)//' | sort -u | tr '\n' ' ')
  echo "  $(basename "$L")  [SELF=$SELF]  引用: ${REFS:-（无）}"
done
echo
echo "== [特别盯防 2] [6] 裸 cmd_vel 依据：launch 层 cmd_vel 命中与排除规则对照 =="
echo "-- 原始命中（含排除前） --"
grep -rn "cmd_vel" /home/ros1-slam/ws/src/*/lite3_*/launch/ 2>/dev/null
echo "-- 脚本排除规则（grep -v lite3_safety | grep -v cmd_vel_raw）后剩余（期望空） --"
grep -rn "cmd_vel" /home/ros1-slam/ws/src/*/lite3_*/launch/ 2>/dev/null | grep -v "lite3_safety" | grep -v "cmd_vel_raw"
echo "LEFT_EXIT=$?（1=空）"
echo "-- 排除合理性注记：cmd_vel_raw_relay.launch=路径含 cmd_vel_raw（C7 载体，node 行注释态）；mbf_navigation.launch 行16=注释内含 cmd_vel_raw 字样（行级排除命中）；60_safety.launch 3 行=路径含 lite3_safety（M6 本体，/cmd_vel 唯一写者）"
