#!/usr/bin/env bash
# G3a 判据① 独立复核脚本（小美，2026-10-04）——以 ros1-slam 身份执行
# 私有 master 11411：全量 rosparam load 两个 config 目录全部 yaml（含 variants/），三列表非空，验完退净
set +u
PASS=0; FAIL=0

echo "== [env.sh 守卫检查] source /home/ros1-slam/scripts/env.sh（P5 未编译，期望守卫触发） =="
source /home/ros1-slam/scripts/env.sh
echo "env.sh source 退出码=$?（1=守卫触发：ws/devel 不存在，属 P3a 预期）"
echo "== [构造环境]（G2 既定规程：devel 未编译期 source /opt/ros + 追加 ws/src） =="
source /opt/ros/noetic/setup.bash
export ROS_PACKAGE_PATH="$ROS_PACKAGE_PATH:/home/ros1-slam/ws/src"
export ROS_MASTER_URI=http://localhost:11411
export ROS_HOME=/tmp/g3a_yan_ros_home
echo "ROS_MASTER_URI=$ROS_MASTER_URI"
echo "ROS_PACKAGE_PATH 逐段："; echo "$ROS_PACKAGE_PATH" | tr ':' '\n'

echo
echo "== [1] 起私有 master：setsid roscore -p 11411（ros1-slam 身份） =="
setsid roscore -p 11411 >/tmp/g3a_roscore.log 2>&1 &
sleep 1
UP=1
for i in $(seq 1 30); do
  if rosparam list >/dev/null 2>&1; then UP=0; break; fi
  sleep 1
done
echo "master 就绪探测：exit=$UP（0=就绪），等待 ${i}s"
if [ $UP -ne 0 ]; then echo "FATAL: master 未就绪"; exit 9; fi
ps -u ros1-slam -o pid,cmd | grep -E "roscore|rosmaster|rosout" | grep -v grep

echo
echo "== [2] rosparam load 全量（两 config 目录全部 yaml，含 variants/ 子目录；计数期望 12） =="
