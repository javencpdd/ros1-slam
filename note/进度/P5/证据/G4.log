#!/usr/bin/env bash
# G4 核心判据独立复核（严过关，2026-10-04）——以 ros1-slam 身份执行
echo "== 判据1：ws/devel/setup.bash 存在性 =="
ls -la /home/ros1-slam/ws/devel/setup.bash
test -f /home/ros1-slam/ws/devel/setup.bash && echo "DEVEL_SETUP=EXISTS" || echo "DEVEL_SETUP=MISSING"
echo
echo "== 判据2：source ws/devel/setup.bash 后 rospack find 六包（v4 §10 P5.2 + v3 A9 + v4 N8） =="
source /home/ros1-slam/ws/devel/setup.bash
echo "ROS_PACKAGE_PATH=$ROS_PACKAGE_PATH"
for p in faster_lio hdl_localization lite3_bringup lite3_safety teb_local_planner mbf_costmap_nav; do
  echo "rospack find $p -> $(rospack find $p 2>&1)"
done
echo
echo "== P4 增补附加（v4 §9）：nav_core_adapter 应指向 /opt/ros/noetic/share =="
echo "rospack find nav_core_adapter -> $(rospack find nav_core_adapter 2>&1)"
echo
echo "== 判据3：echo \$ROS_PACKAGE_PATH | grep -c /home/ysc（期望 0） =="
echo "$ROS_PACKAGE_PATH" | grep -c "/home/ysc"
echo "grep_count_exit=$?（1=零命中）"
echo "$ROS_PACKAGE_PATH" | tr ':' '\n'
