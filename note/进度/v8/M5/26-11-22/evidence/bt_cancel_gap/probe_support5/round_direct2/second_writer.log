SW_FRESH_LOCAL_GOAL=True LOCAL_MATCH=((1.95, 0.95), (1.95, 0.95)) LOCAL_LAST=(1.95, 0.95)（须 True：局部规划器输入口收到的点等于某条新路径的末点）
SW_FRESH_LOCAL_HIT_GOAL=True（读数不判：局部目标是否已贴住操作员目标）
SW_FRESH_PATH_GOAL_STATUS={'ok': True, 'poses': 10, 'goal': [1.95, 0.95, 0.0], 'frame': 'map'}
