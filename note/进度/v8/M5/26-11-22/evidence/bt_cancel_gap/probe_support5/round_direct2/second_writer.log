SW_FRESH_CHAIN_WAYPOINT n=0 HIT=False FIRST=None（上游回的 /way_point，HIT＝窗内出现过贴新目标的航点）
SW_FRESH_OK=True（派发 + 取队 + 适配器转发新目标 + 非空重规划路径 + 局部目标等于该路径末点 六項全过）
SW_FRESH_ATTEMPTS=1（1＝一次就接；>1＝首条没派发、重发才接）
SW_FRESH_HISTORY=[(1, True, 1, 10, 0.3, True)]（次数, 派发, seq增, 路径点数, 等路径秒, 局部目标）
