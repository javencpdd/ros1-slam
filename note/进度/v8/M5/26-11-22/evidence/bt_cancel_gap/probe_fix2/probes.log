=== round_direct1 (mode=direct queue_old=3 phase=arrival backend=far) ===
GAP_PRECHECK=PORTS_FREE
GAP_BOOT=MASTER_READY
ROUND_direct1 READY_GATE=READY_GATE=READY
ROUND_direct1 PROBE_RC=0 ELAPSED_S=17
  SW_MODE=direct TAG=direct1 QUEUE_OLD=3 PHASE_ARG=arrival
  SW_WARM_ATTEMPTS=1
  SW_PATHS_BEFORE_CANCEL=1
  SW_PATH_STATUS_AFTER_WARM={'ok': True, 'points': 2, 'reason': 'ok'}
  SW_QUEUE_DEPTH_BEFORE_CANCEL=1（须 >= 3，否则旧目标没排上，本题无意义）
  SW_BT_LANDING_NODE=wait_arrival PHASE=ARRIVAL（发帧前一瞬 BT 的 RUNNING 节点）
  SW_PATH_STATUS_AT_T0={'ok': True, 'points': 2, 'reason': 'ok'}
  SW_CANCEL_FORWARDED=True（第二写者自己发的帧，BT 不知情）
  SW_CANCEL_ACK_CANCELLED=True
  SW_OLD_QUEUE_WINDOW_S=8.0
  SW_QUEUE_DEPTH_AT_T0=1（取消前队列深度快照，仅作上下文）
  SW_OLD_DISPATCHED=False（/v8/global/goal 上出现旧目标坐标，须 False）
  SW_OLD_GOAL_SEQ=1->1（须不变）
  SW_OLD_NEW_PATH_STAMPS=0（旧目标若跑起来这里会 >0）
  SW_QUEUE_DEPTH_END=0 PENDING_DROPPED=1（须 0 / >= 1）
  SW_CANCEL_ORIGIN=external EVENT=localization_ok
  SW_QUEUE_SAFE=True
  SW_FRESH_WINDOW_S=8.0
  SW_FRESH_DISPATCHED=False（新目标在窗内被派发）
  SW_FRESH_GOAL_SEQ=1->1 SW_FRESH_PATHS=0
  SW_VERDICT=FAIL
  SW_EXPECT=PASS（queue-old：旧目标停住 + 新目标可下发，两段都要）
  SW_DISCRIMINATING=False
GAP_PORTS_FREE
ROUND_direct1 STATS arrival_timeout=0 goal_queued=3 depth_max=1 dequeued=2 external_cancel=1 drop_events=1
