SW_CASE=race TAG=race1
SW_GOAL_SENT tag=warm1 xy=(2.00, 0.00)
SW_WARM_ATTEMPTS=1
SW_LANDING_NODE=wait_arrival
SW_BEFORE EXTERNAL_SEQ=0 ORIGIN= EVENT=localization_ok LEG_ACTIVE=True PENDING_DROPPED=0 QUEUE_DEPTH=0 WIRE=0 BACKEND=0 STRAY=0 STALEQ=0 NODE=wait_arrival
SW_LIVE_LEG=True（须 True）
SW_GOAL_SENT tag=oldA xy=(3.00, 0.00)
SW_GOAL_SENT tag=oldB xy=(4.00, 0.00)
