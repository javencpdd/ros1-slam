SW_WIRE_INJECTED seq=900000008（/v8/local/cancel，外来帧）
SW_AFTER_RACE EXTERNAL_SEQ=900000008 ORIGIN=external_wire EVENT=localization_ok LEG_ACTIVE=False PENDING_DROPPED=2 QUEUE_DEPTH=0 WIRE=1 BACKEND=1 STRAY=0 STALEQ=0 NODE=wait_goal
SW_RACE_DELAY=1.000 BRANCH=latch(有活腿)
SW_RACE_GOAL_SEQ=1->1（须不变：不得取走旧目标）
SW_RACE_OLD_DISPATCHED=False（须 False：/v8/global/goal 上不得出现旧目标坐标）
SW_RACE_QUEUE_DEPTH=0（须 0：旧目标被清掉，不是留着等下一拍）
SW_RACE_BRANCH ORIGIN=external_wire PENDING_DROPPED=2 STALEQ=0 WIRE=1（两分支都合法，只要能清干净）
