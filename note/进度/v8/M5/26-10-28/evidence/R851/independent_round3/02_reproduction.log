### 1.2 触发点截断（本轮新发现）

```bash
$ cd /tmp/r851 && python3 - <<'PY'
import json
for i in (1,2,3):
    d=json.load(open(f'note/进度/v8/M5/26-10-28/evidence/R850/noroute_run{i}.json')); c=d['cases'][0]
    rows=sorted([r for r in d['raw']['physics'] if r['phase']=='sensed_no_route'], key=lambda r:r['wall'])
    tr=c['trigger']['wall']; stop=tr+c['trigger_to_physical_stop_wall_s']
    before=max([r for r in rows if r['wall']<tr], key=lambda r:r['wall'])
    after=min([r for r in rows if r['wall']>=tr], key=lambda r:r['wall'])
    frac=(tr-before['wall'])/(after['wall']-before['wall'])
    xtr=before['xyz'][0]+frac*(after['xyz'][0]-before['xyz'][0])
    last=max([r for r in rows if r['wall']<=stop+1e-6], key=lambda r:r['wall'])
    print(i, round(before['xyz'][0],5), round(after['xyz'][0],5), round(xtr,5),
          round(last['xyz'][0],5), round(last['xyz'][0]-after['xyz'][0],4),
          round(last['xyz'][0]-xtr,4), round(last['xyz'][0]-before['xyz'][0],4))
PY
1 0.02634 0.03791 0.02892 0.16001 0.1221 0.1311 0.1337
2 0.03033 0.04230 0.03236 0.15761 0.1153 0.1253 0.1273
3 0.03591 0.04389 0.03638 0.15961 0.1157 0.1232 0.1237
```

