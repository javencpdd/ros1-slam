<?xml version="1.0"?>
<launch>
  <!-- generated by v8 framework; graph=nav2d_loc_hdl digest=a08f2d4f99c0e0319a04130c0d3632616d9d019d82c283b2e429455f4025d26f -->
  <arg name="graph_digest" default="a08f2d4f99c0e0319a04130c0d3632616d9d019d82c283b2e429455f4025d26f"/>
  <node pkg="map_server" type="map_server" name="map">
  </node>
  <node pkg="lite3_drivers" type="sim_adapter.py" name="sensors">
  </node>
  <include file="$(find lite3_localization)/launch/hdl_localization.launch">
    <arg name="imu_topic" value="/livox/imu"/>
    <arg name="map_name" value="lite3"/>
    <arg name="points_topic" value="/rslidar_points"/>
  </include>
  <node pkg="v8_platform" type="global2d_test_double" name="global">
    <remap from="/Odometry" to="/hdl_odom"/>
    <remap from="/map" to="/map"/>
  </node>
  <node pkg="v8_platform" type="local2d_test_double" name="local">
    <remap from="/Odometry" to="/hdl_odom"/>
    <remap from="/global_path" to="/global_path"/>
    <remap from="/map" to="/map"/>
  </node>
  <node pkg="lite3_safety" type="safe_cmd_vel_mux.py" name="mux">
    <rosparam command="load" file="$(find lite3_safety)/config/cmd_vel_mux.yaml"/>
    <param name="default_priority" value="navigation"/>
    <remap from="/cmd_vel_advice/local" to="/cmd_vel_advice/local"/>
  </node>
  <node pkg="message_transformer" type="ros2qnx" name="robot">
    <remap from="/cmd_vel" to="/cmd_vel"/>
  </node>
</launch>
