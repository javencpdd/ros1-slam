<?xml version="1.0"?>
<launch>
  <!-- generated by v8 framework; graph=nav3d_two_caches digest=b8761496dc53a5c4cbc86fc0a4855e53757aa08e1c1edb8dc11f8ee36611d7ff -->
  <arg name="graph_digest" default="b8761496dc53a5c4cbc86fc0a4855e53757aa08e1c1edb8dc11f8ee36611d7ff"/>
  <node pkg="lite3_drivers" type="sim_adapter.py" name="sensors">
  </node>
  <include file="$(find lite3_slam)/launch/10_slam_mapping.launch">
  </include>
  <node pkg="v8_platform" type="map3d_test_double" name="map">
    <remap from="/cloud_registered" to="/cloud_registered"/>
    <remap from="/map_delta" to="/map_delta"/>
  </node>
  <node pkg="v8_platform" type="map_cache_test_double" name="cache_a">
    <param name="max_delta_cells" value="2000"/>
    <param name="update_interval_s" value="5.0"/>
    <remap from="/Odometry" to="/Odometry"/>
    <remap from="/cloud_registered" to="/cloud_registered"/>
    <remap from="/v8_support_map" to="/v8_support_map"/>
  </node>
  <node pkg="v8_platform" type="map_cache_test_double" name="cache_b">
    <param name="max_delta_cells" value="2000"/>
    <param name="update_interval_s" value="10.0"/>
    <remap from="/Odometry" to="/Odometry"/>
    <remap from="/cloud_registered" to="/cloud_registered"/>
    <remap from="/v8_support_map" to="/v8_support_map"/>
  </node>
  <node pkg="v8_platform" type="global3d_test_double" name="global">
    <remap from="/Odometry" to="/Odometry"/>
    <remap from="/v8_support_map" to="/v8_support_map"/>
  </node>
  <node pkg="v8_platform" type="local3d_test_double" name="local">
    <remap from="/Odometry" to="/Odometry"/>
    <remap from="/global_path" to="/global_path"/>
    <remap from="/v8_support_map" to="/v8_support_map"/>
  </node>
  <node pkg="v8_platform" type="map_merge_test_double" name="merge">
    <param name="policy" value="newest_wins"/>
  </node>
  <node pkg="lite3_safety" type="safe_cmd_vel_mux.py" name="mux">
    <rosparam command="load" file="$(find lite3_safety)/config/cmd_vel_mux.yaml"/>
    <remap from="/cmd_vel_advice/local" to="/cmd_vel_advice/3d"/>
  </node>
  <node pkg="message_transformer" type="ros2qnx" name="robot">
    <remap from="/cmd_vel" to="/cmd_vel"/>
  </node>
</launch>
