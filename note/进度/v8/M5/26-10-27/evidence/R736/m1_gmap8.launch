<launch>
  <node pkg="nodelet" type="nodelet" name="hdl_manager8" args="manager" output="screen"/>
  <node pkg="nodelet" type="nodelet" name="globalmap_server8"
        args="load hdl_localization/GlobalmapServerNodelet hdl_manager8 --no-bond">
    <param name="globalmap_pcd" value="/opt/ros1-slam/data/maps/lite3.pcd"/>
    <param name="convert_utm_to_local" value="false"/>
    <param name="downsample_resolution" value="0.1"/>
  </node>
</launch>
