<launch>
  <arg name="map" default="/work/maps/m1_world.pcd"/>
  <node pkg="nodelet" type="nodelet" name="hdl_manager2" args="manager" output="screen"/>
  <node pkg="nodelet" type="nodelet" name="globalmap_server2"
        args="load hdl_localization/GlobalmapServerNodelet hdl_manager2 --no-bond">
    <param name="globalmap_pcd" value="$(arg map)"/>
    <param name="convert_utm_to_local" value="false"/>
    <param name="downsample_resolution" value="0.1"/>
  </node>
</launch>
