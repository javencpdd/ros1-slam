<launch>
  <!-- 矩阵W3 勘察独立 mockamap（perlin3d 模板参数=95_sim.launch W2 T1 同值，零 remap 发 /mock_map） -->
  <node pkg="mockamap" type="mockamap_node" name="mockamap_node" output="screen">
    <param name="seed"        type="int"    value="511"/>
    <param name="update_freq" type="double" value="1.0"/>
    <param name="resolution"  type="double" value="0.15"/>
    <param name="x_length"    type="int"    value="40"/>
    <param name="y_length"    type="int"    value="20"/>
    <param name="z_length"    type="int"    value="5"/>
    <param name="type"        type="int"    value="1"/>
    <param name="road_width"  type="double" value="1.2"/>
    <param name="add_wall_x"  type="int"    value="1"/>
    <param name="add_wall_y"  type="int"    value="1"/>
    <param name="maze_type"   type="int"    value="1"/>
    <param name="complexity"         type="double" value="0.07"/>
    <param name="fill"               type="double" value="0.1"/>
    <param name="fractal"            type="int"    value="1"/>
    <param name="attenuation"        type="double" value="0.1"/>
    <param name="width_min"          type="double" value="0.6"/>
    <param name="width_max"          type="double" value="1.5"/>
    <param name="obstacle_number"    type="int"    value="50"/>
    <param name="surface_resolution" type="double" value="0.03"/>
  </node>
</launch>
