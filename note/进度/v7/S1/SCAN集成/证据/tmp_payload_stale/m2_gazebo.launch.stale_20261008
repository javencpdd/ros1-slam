<launch>
  <!-- m2_gazebo.launch —— M2 仿真台（小张 payload，2026-10-06）：m1_gazebo.launch 同构，仅两处增量：
       ① <env> 注入 GAZEBO_PLUGIN_PATH=ws/devel/lib（lite3_planar_drive.so 产出位）+ /opt/ros/noetic/lib（fratopa/gazebo 插件）；
       ② xacro=M2 版（lite3_planar_drive 替身插件，driveMode 由探针 M2-1-D 裁定后固化）。
       隔离域：由调用方（m2_smoke.sh）设 ROS_MASTER_URI=11313 / GAZEBO_MASTER_URI=11355；本 launch 不设，保持可复用。 -->
  <arg name="gui" default="false"/>
  <arg name="payload_dir" default="$(find lite3_gazebo_sim)"/>
  <env name="GAZEBO_PLUGIN_PATH" value="/home/ros1-slam/ws/devel/lib:/opt/ros/noetic/lib"/>

  <param name="use_sim_time" value="true"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg payload_dir)/worlds/m1_world.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
    <arg name="verbose" value="false"/>
  </include>

  <param name="robot_description" command="$(find xacro)/xacro $(arg payload_dir)/urdf/lite3_planar.urdf.xacro"/>
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>
  <node name="spawn_lite3_planar" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -param robot_description -model lite3_planar -x 0 -y 0 -z 0.15"/>

  <node name="sim_adapter" pkg="lite3_drivers" type="sim_adapter.py"
        args="--input custommsg --no-imu --rate-lidar 10" output="screen"/>
</launch>
