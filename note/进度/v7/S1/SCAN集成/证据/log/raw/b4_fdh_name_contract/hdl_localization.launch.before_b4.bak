<?xml version="1.0"?>
<launch>
  <!-- ══════════════════════════════════════════════════════════════════════════════
       lite3_localization(M2) 自研壳 launch —— hdl_localization 节点承载（P7 A3）。
       依据：GAP-2 主理人裁决——不砍第三方 launch，新建自研 launch 承载 hdl_localization 节点定义。

       第三方原件 = hdl_localization/launch/local_rslidar_imu.launch（原样保留、永不 include），
       其尾两行必炸（缺陷登记 02 坑册，坑6）：
         ① <include file="$(find navigation)/launch/navigation.launch"/> —— ws 无 navigation 包，
            roslaunch 解析即败；
         ② <node name="rviz" ... required="true"/> —— SSH 无 X 必崩且拖死整窗（C10 已注）。

       本文件节点/参数/remap 逐字照抄原件中经 P6.2 实测装载成功的部分（nodelet manager +
       GlobalmapServerNodelet + HdlLocalizationNodelet；remap /velodyne_points→/rslidar_points、
       /gpsimu_driver/imu_data→/imu/data 逐字对——P63_localize.log L22），零编造参数。
       与原件的三处偏差（均有据，登记 04 台账）：
         a) MapServer(map_server) 节点不收编——A6 裁决 a：mode_localize 不含 map_server。
            样张 lite3.yaml origin z=nan 被 map_server 拒载（D-L1，yaml-cpp bad conversion，
            裁决4：样张不回改、修 yaml 与底图重采同场）；hdl 用 pcd（globalmap_server_nodelet），
            2D /map 归 M4 costmap 链（G8 后段按位供给）。也不做派生副本——违反裁决4 通道
            与 P7「零新增数据文件」硬约束。
         b) 剔除必炸尾两行（见上①②）。
         c) 增补 C13-② M2 心跳行（GAP-1 转正，话题逐字 = health_watch.yaml M2_localization）。
       hdl 参数文件引用方式照该包现状：globalmap_pcd = /home/ros1-slam/data/maps/$(arg map_name).pcd
       （原件同款绝对路径风格；隔离自检 [2]/[8] 禁的是 ysc 家目录硬编码，不涉本路径）。
       ══════════════════════════════════════════════════════════════════════════════ -->
  <!-- arguments -->
  <arg name="nodelet_manager" default="velodyne_nodelet_manager" />
  <arg name="points_topic" default="/rslidar_points" />
  <arg name="map_name" default="lite3" />
  <!-- base_link→rslidar 外参 args（小张 G8 备战包 B 单 2026-10-05；数值回填前保持 0 占位——【现场量：G8 演练命令行试值后固化】） -->
  <arg name="tf_x" default="0.0" />      <!-- 现场量：雷达相对 base_link 前向偏移 -->
  <arg name="tf_y" default="0.0" />      <!-- 现场量：雷达相对 base_link 左向偏移 -->
  <arg name="tf_z" default="0.0" />      <!-- 现场量：0.38 − h_base，h_base=平地站姿 base_link 离地高 -->
  <arg name="tf_pitch" default="0.0" />  <!-- Q13：粗测量角器 → G8 残差反推精修（倾向 7.5°） -->
  <!-- input clouds are transformed in odom_child_frame, and then localization is performed in that frame -->
  <!-- this is useful to match the LIDAR and IMU coodinate systems -->
  <arg name="odom_child_frame_id" default="base_link" />

  <!-- M2-R2C（小张 R2C manifest 施工件2，2026-10-06）：manager_required=manager 崩则整窗退；
       clock_gate_cmd=/clock 门控 launch-prefix（阻塞至 /clock 首帧再 exec manager，消除冷启动
       RTF 突发窗内 nodelet 栈 segv/bond 二象竞态）。缺省 false/""=现行为（真机 G8 默认零影响） -->
  <arg name="manager_required" default="false" />
  <arg name="clock_gate_cmd" default="" />

  <!-- optional arguments -->
  <arg name="use_imu" default="true" />
  <arg name="invert_imu_acc" default="false" />
  <arg name="invert_imu_gyro" default="false" />
  <arg name="use_global_localization" default="false" />
  <arg name="imu_topic" default="/imu/data" />
  <arg name="enable_robot_odometry_prediction" value="false" />
  <arg name="robot_odom_frame_id" value="odom" />
  <arg name="plot_estimation_errors" value="false" />

  <include file="$(find hdl_global_localization)/launch/hdl_global_localization.launch" if="$(arg use_global_localization)" />

  <!-- base_link→rslidar 静态外参（G8 定案形态，小张 B 单 2026-10-05）：z=0.38−h_base（h_base 现场量），pitch=Q13 精测值；
       【现场量：G8 演练命令行试值后固化】——数值回填前保持 0 占位，不得以恒等阵蒙混上 G8（G8-2 判据：恒等阵=不通过）；
       P6/P7 命令行恒等阵 stub 自此退役（销坑记录见 02） -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_rslidar"
        args="$(arg tf_x) $(arg tf_y) $(arg tf_z) 0.0 $(arg tf_pitch) 0.0 /base_link /rslidar" />
  <!-- in case you use velodyne_driver, comment out the following line -->
  <node pkg="nodelet" type="nodelet" name="$(arg nodelet_manager)" args="manager"
        required="$(arg manager_required)" launch-prefix="$(arg clock_gate_cmd)" output="screen"/>

    <!-- globalmap_server_nodelet（M2-R2C：两处 load args 尾加 no_bond 开关即 no-bond 旗标，消除跨进程 bond 墙钟心跳失联形态；注释禁双连字符=D-仿真可用化-2 同款） -->
    <node pkg="nodelet" type="nodelet" name="globalmap_server_nodelet" args="load hdl_localization/GlobalmapServerNodelet $(arg nodelet_manager) --no-bond">
      <param name="globalmap_pcd" value="/home/ros1-slam/data/maps/$(arg map_name).pcd" />
      <param name="convert_utm_to_local" value="true" />
      <param name="downsample_resolution" value="0.1" />
    </node>

    <!-- hdl_localization_nodelet -->
    <node pkg="nodelet" type="nodelet" name="hdl_localization_nodelet" args="load hdl_localization/HdlLocalizationNodelet $(arg nodelet_manager) --no-bond">
      <remap from="/velodyne_points" to="$(arg points_topic)" />
      <param name="lidar_timeout_ms" value="9999" />
      <remap from="/gpsimu_driver/imu_data" to="$(arg imu_topic)" />
      <!-- odometry frame_id -->
      <param name="odom_child_frame_id" value="$(arg odom_child_frame_id)" />
      <!-- imu settings -->
      <!-- during "cool_time", imu inputs are ignored -->
      <param name="use_imu" value="$(arg use_imu)" />
      <param name="imu_timeout_ms" value="9999" />
      <param name="invert_acc" value="$(arg invert_imu_acc)" />
      <param name="invert_gyro" value="$(arg invert_imu_gyro)" />
      <param name="cool_time_duration" value="2.0" />
      <!-- robot odometry-based prediction -->
      <param name="enable_robot_odometry_prediction" value="$(arg enable_robot_odometry_prediction)" />
      <param name="robot_odom_frame_id" value="$(arg robot_odom_frame_id)" />
      <!-- ndt settings -->
      <!-- available reg_methods: NDT_OMP, NDT_CUDA_P2D, NDT_CUDA_D2D-->
      <param name="reg_method" value="NDT_OMP" />
      <!-- if NDT is slow for your PC, try DIRECT1 serach method, which is a bit unstable but extremely fast -->
      <param name="ndt_neighbor_search_method" value="DIRECT1" />
      <param name="ndt_neighbor_search_radius" value="3.0" />
      <param name="ndt_resolution" value="2.0" />
      <param name="downsample_resolution" value="1.0" />
      <!-- if "specify_init_pose" is true, pose estimator will be initialized with the following params -->
      <!-- otherwise, you need to input an initial pose with "2D Pose Estimate" on rviz" -->
      <param name="specify_init_pose" value="true" />
      <param name="init_pos_x" value="0.0" />
      <param name="init_pos_y" value="0.0" />
      <param name="init_pos_z" value="0.0" />
      <param name="init_ori_w" value="1.0" />
      <param name="init_ori_x" value="0.0" />
      <param name="init_ori_y" value="0.0" />
      <param name="init_ori_z" value="0.0" />

      <param name="use_global_localization" value="$(arg use_global_localization)" />
    </node>

    <node pkg="hdl_localization" type="plot_status.py" name="plot_estimation_errors" if="$(arg plot_estimation_errors)" />

  <!-- C13-② 模块心跳（P7 A3 / GAP-1 转正）：
       watch 侧比对 health_watch.yaml#modes.*.watch(M2_localization)，话题逐字 = /lite3/liveness/m2_localization -->
  <node pkg="rostopic" type="rostopic" name="liveness_m2" args="pub -r 1 /lite3/liveness/m2_localization std_msgs/Empty"/>
</launch>
