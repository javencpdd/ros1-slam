# PCD→octree→/map（窗口B，等价替代不存在的 11_postprocess.launch）
$ sudo -u ros1-slam bash -c 'source env.sh && nohup rosrun octomap_server octomap_server_node \
    _frame_id:=map _resolution:=0.05 _pointcloud_min_z:=0.4 _pointcloud_max_z:=1.2 \
    _occupancy_min_z:=0.0 _occupancy_max_z:=1.6 _latch:=true \
    _sensor_model/max_range:=100.0 _sensor_model/min_range:=-1.0 \
    cloud_in:=/cloud_pcd projected_map:=/map > /tmp/g3_octomap.log 2>&1 &'
$ sudo -u ros1-slam bash -c 'source env.sh && timeout 8 rosrun pcl_ros pcd_to_pointcloud \
    /home/ros1-slam/data/maps/lite3.pcd 2 _frame_id:=map _topic:=cloud_pcd > /tmp/g3_pcd2pc.log 2>&1'
