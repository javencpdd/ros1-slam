# costmap_common.yaml —— costmap 公共配置（v4 C0：底稿 opt/ref/navigation_params_orig/common_costmap_params.yaml 原样拷入；C3：四参数编辑，改动行以 "C3" 标注）
# costmap 参数在 mbf 下同名生效（结构原样沿用）；挂载 ns 见 mbf_navigation.launch（Q11）
# from source code
global_frame: map
robot_base_frame: base_link
rolling_window: true
track_unknown_space: false
always_send_full_costmap: false

# from cfg file
transform_tolerance: 1.0
update_frequency: 10
publish_frequency: 5
resolution: 0.1
origin_x: 0
origin_y: 0
footprint: [[-0.3, -0.2], [-0.3, 0.2], [0.3, 0.2], [0.3, -0.2]]
footprint_padding: 0.1

static_layer:
  map_topic: map
  first_map_only: true
  subscribe_to_updates: false
  track_unknown_space: false
  use_maximum: true
  lethal_cost_threshold:  100
  unknown_cost_value: -1
  trinary_costmap: true

stvl_obstacle_layer:
  observation_sources:   rslidar_points
  transform_tolerance:   1.0    # seconds
  enabled:               true
  publish_voxel_map:     true   # default off
  voxel_size:            0.10   #meters  C3（底稿 0.05）
  combination_method:    1      #1=max, 0=override
  mark_threshold:        0      #voxel height
  update_footprint_enabled: true
  track_unknown_space:   false   #default space is unknown
  decay_model:           0      #0=linear, 1=exponential, -1=persistent
  voxel_decay:           10.0    #seconds if linear, e^n if exponential  C3（底稿 0.3）
  mapping_mode:          false  # default off, saves map not for navigation
  map_save_duration:     60     #default 60s, how often to autosave

  rslidar_points:
    topic: /rslidar_points
    sensor_frame: rslidar
    observation_persistence: 0.5  #default 0, use all measurements taken during now-value, 0=latest
    expected_update_rate: 10.0     #default 0, if not updating at this rate at least, remove from buffer
    data_type: PointCloud2
    min_obstacle_height: 0.15      #default 0, meters
    max_obstacle_height: 1.5      #defaule 3, meters
    inf_is_valid: false           #default false, for laser scans
    marking: true
    clearing: true    # C3（F2 坑1：底稿 false，观测永不清除）
    min_z: 0.2    # C3/Q3 占位：保留底稿值，tf_echo base_link rslidar 体检后修订（C16 安装倾角实测后回填）
    max_z: 3.0
    vertical_fov_angle: 0.56
    vertical_fov_padding: 0.0
    horizontal_fov_angle: 6.29
    decay_acceleration: 5
    filter: voxel               #default passthrough, apply "voxel", "passthrough", or no filter to sensor data, recommended to have at one filter on
    voxel_min_points: 3           #default 0, minimum points per voxel for voxel filter
    clear_after_reading: false    #default false, clear the buffer after the layer gets readings from it
    enabled: true
    model_type: 1
    obstacle_range: 8.0           #meters  C3（F2 坑3：底稿 3.0 太近）

sob_layer:
  enabled: true
  inflate_unknown: false
  inscribed_radius: 0.15
  inflation_radius: 0.2
  cost_scaling_factor: 10


