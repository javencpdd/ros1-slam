{
  "schema_version": 1,
  "id": "v8.controller.teb_adapter",
  "version": "apt:148",
  "roles": [
    "controller"
  ],
  "tags": [
    "indoor",
    "flat",
    "cpu"
  ],
  "io": {
    "map_schema": "occupancy_grid/v1",
    "dimensions": 2,
    "inputs": [
      "nav_msgs/Path（全局路径）",
      "costmap_2d/Costmap（局部代价图）"
    ],
    "outputs": [
      "geometry_msgs/Twist（经 safe_cmd_vel_mux 仲裁）"
    ]
  },
  "capability": {
    "kinematics": "differential",
    "cancellation": "cooperative",
    "supports_dynamic_obstacles": true
  },
  "ownership": {
    "tf_edges": [],
    "command_topics": [
      "/cmd_vel_advice/teb（建议输出，经 safe_cmd_vel_mux 仲裁；/cmd_vel 唯一写者＝safety_arbiter，22 号差异表）"
    ],
    "namespace": "/move_base",
    "stop": "process_group_signal"
  },
  "evidence": {
    "level": "declared",
    "reports": []
  },
  "source": {
    "uri": "apt ros-noetic-teb-local-planner（Dockerfile:148）",
    "license": "宿主不可证（apt 侧）",
    "commit": "宿主不可证"
  },
  "adapter_entry": "move_base/mbf 控制器适配（teb_local_planner）；kinematics 按 differential 声明——佐证＝历史证据面「TEB 2D 刚体假设」与实栈无横向速度迹象；定案须容器面读配置（宿主 ws 无 teb/dwa 配置件，R616 十六件引用在容器侧），留运行批"
}
