{
  "title": "component_manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "roles",
    "io",
    "capability",
    "ownership",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "odometry",
          "global_localization",
          "mapping",
          "map_server",
          "representation",
          "global_planner",
          "local_planner",
          "controller",
          "trajectory_validator",
          "safety_arbiter",
          "simulator",
          "evaluator"
        ]
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "indoor",
          "outdoor",
          "flat",
          "ramp",
          "stairs_geometry",
          "multilevel",
          "underpass",
          "dynamic_obstacles",
          "ground",
          "quadruped",
          "differential",
          "holonomic",
          "planar",
          "single_height",
          "multisurface",
          "voxel",
          "mesh",
          "cpu",
          "gpu_optional",
          "gpu_required",
          "offline",
          "simulation",
          "real_robot"
        ]
      }
    },
    "io": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "map_schema",
        "dimensions",
        "inputs",
        "outputs"
      ],
      "properties": {
        "map_schema": {
          "enum": [
            "occupancy_grid/v1",
            "support_map/v1",
            "not_applicable"
          ]
        },
        "dimensions": {
          "enum": [
            2,
            3
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kinematics",
        "cancellation",
        "supports_dynamic_obstacles"
      ],
      "properties": {
        "kinematics": {
          "enum": [
            "differential",
            "holonomic",
            "quadruped_kinematic",
            "not_applicable"
          ]
        },
        "cancellation": {
          "enum": [
            "cooperative",
            "cooperative_with_process_watchdog",
            "none"
          ]
        },
        "supports_dynamic_obstacles": {
          "type": "boolean"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "license"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adapter_entry": {
      "type": "string",
      "minLength": 1
    },
    "param_schema": {
      "type": "string",
      "minLength": 1
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tf_edges",
        "command_topics",
        "namespace",
        "stop"
      ],
      "properties": {
        "tf_edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parent",
              "child"
            ],
            "properties": {
              "parent": {
                "type": "string",
                "minLength": 1
              },
              "child": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "command_topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "namespace": {
          "type": "string",
          "pattern": "^(/|(/[a-z0-9_]+)+)$"
        },
        "stop": {
          "enum": [
            "service_stop",
            "process_group_signal",
            "none"
          ]
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sensors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "enum": [
              "cpu",
              "gpu_optional",
              "gpu_required"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "reports"
      ],
      "properties": {
        "level": {
          "enum": [
            "declared",
            "contract_tested",
            "simulation_verified",
            "robot_verified"
          ]
        },
        "reports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
