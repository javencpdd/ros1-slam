# =============================================================================
# docker compose 变量模板 —— 用前复制成 docker/.env
# 最新更新时间：2026-11-06 04:07:49 CST
#   cp docker/.env.example docker/.env
# =============================================================================

# ---- 镜像与构建 ----
# ★ 本机实测（2026-10-17）：宿主机已有 fishros2/ros:noetic-desktop-full（4.77GB, amd64），
#   含 Gazebo 11.10.2 + 234 个 ros-noetic 包 ⇒ 用它零拉取、最快。
#   换回官方镜像：ROS_BASE_IMAGE=ros + ROS_BASE_TAG=noetic-ros-base-focal（需走代理且很慢）
#   换 USTC 源：ROS_BASE_IMAGE=docker.mirrors.ustc.edu.cn/library/ros
ROS_BASE_IMAGE=fishros2/ros
ROS_BASE_TAG=noetic-desktop-full
IMAGE=ros1-slam:noetic-sim           # 镜像名（build 后用这个，或改成本地仓库地址）
                                     # 2026-11-16 起默认值与 SIM_IMAGE 对齐：本项目只产这一个
                                     # tag（dev 在 Dockerfile 里是 sim 的别名），原默认 tag
                                     # ros1-slam:noetic 本机从未构建过、会让 roscore/slam
                                     # 退化成现场构建。
SIM_IMAGE=ros1-slam:noetic-sim       # sim / sim-viz / roscore / rosbridge / web 共用此 tag
PROFILE=sim                          # x86_sim requires Gazebo; core is rejected, dev aliases sim
WITH_RVIZ=0                          # 1 = 额外装 rviz / rqt（约 +400MB）
JOBS=4                               # x86 build concurrency; message pre-generation is handled by the helper
SLIM=0                               # compatibility only; SLIM=1/nonzero is rejected

# ---- 宿主机用户映射（避免容器写出的文件变成 root 属主）----
# 取值：宿主机执行 `id -u` / `id -g`
HOST_UID=1000
HOST_GID=1000

# ---- 构建期代理（默认留空 = 国内源直连，更快更稳）----
# ★ 变量名故意不叫 HTTP_PROXY！如果叫 HTTP_PROXY，compose 会把调用方 shell 里的
#   代理顺手继承进构建容器 —— 而 shell 里的 http://127.0.0.1:xxxx 在构建容器内
#   根本不存在 ⇒ apt 全部 Connection refused ⇒ 满屏 "Unable to locate package"，
#   极易误判成"镜像/源坏了"。（2026-10-17 实测踩坑，Dockerfile 里已加 FATAL 自检。）
# 只有换回官方 ros: 基础镜像（源在国外）时才需要显式设，且必须填宿主机局域网 IP。
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_NO_PROXY=localhost,127.0.0.1

# ---- ROS 网络口径 ----
ROS_PORT=11312                                    # roscore 监听端口（项目惯例 11312）
ROS1_MASTER_URI=http://roscore:11312              # bridge 模式：走 compose DNS
ROS1_IP=                                          # bridge 模式留空（自动用 hostname）
HOST_IP=192.168.1.103                             # x86 hostnet template; verify this machine's IP before use

# ---- 宿主端口绑定（2026-11-16 起默认只绑本机环回）----
# web 是仓库文档站（白名单只放行 web/），rosbridge 9090 是可下发的 ROS 桥 ——
# 两者都不该对整个局域网敞开。要给别的机器/手机看，把 BIND 改成宿主机网卡 IP。
WEB_BIND=127.0.0.1
WEB_PORT=80
ROSBRIDGE_BIND=127.0.0.1
ROSBRIDGE_PORT=9090

# ---- 运行时加固与资源上限（2026-11-16 起）----
# 日志轮转：原 json-file 无上限，日志卷实测涨到 4212 文件 / 221MB 且只增不减。
# 单容器上限 10m × 3 份 ⇒ 每个服务最多 30MB，七个服务最多约 210MB。
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
# 内存上限：原来全无限制，一个容器吃满宿主内存时只能等 OOM killer 随机挑进程。
#   Gazebo 实测量级：空场景约 0.6~1.2G，大地图/稠密点云会更高 ⇒ 给 6g 留足余量，
#   同时保留「撞上限就停」的兜底（不要图省事设成不限）。
#   若真撞到 OOM，先 docker stats 看实际峰值再调，别直接放开。
MEM_LIMIT_SIM=6g        # sim：gzserver + 点云
MEM_LIMIT_VIZ=6g        # sim-viz：gzclient/rviz（走宿主 GPU）
MEM_LIMIT_CORE=1g       # roscore / slam
MEM_LIMIT_BRIDGE=512m   # rosbridge
MEM_LIMIT_WEB=512m      # web（纯静态文档）

# ---- GUI（rviz / gzclient，可选）----
DISPLAY=:0
