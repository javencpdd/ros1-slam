# =============================================================================
# docker compose 变量模板 —— 用前复制成 docker/.env
#   cp docker/.env.example docker/.env
# =============================================================================

# ---- 镜像与构建 ----
# ★ 本机实测（2026-10-17）：宿主机已有 fishros2/ros:noetic-desktop-full（4.77GB, amd64），
#   含 Gazebo 11.10.2 + 234 个 ros-noetic 包 ⇒ 用它零拉取、最快。
#   换回官方镜像：ROS_BASE_IMAGE=ros + ROS_BASE_TAG=noetic-ros-base-focal（需走代理且很慢）
#   换 USTC 源：ROS_BASE_IMAGE=docker.mirrors.ustc.edu.cn/library/ros
ROS_BASE_IMAGE=fishros2/ros
ROS_BASE_TAG=noetic-desktop-full
IMAGE=ros1-slam:noetic               # 镜像名（build 后用这个，或改成本地仓库地址）
PROFILE=core                         # core = 只编译运行栈；sim = 额外装 Gazebo11（跑仿真必须 sim）
WITH_RVIZ=0                          # 1 = 额外装 rviz / rqt（约 +400MB）
JOBS=1                               # 编译并发。★干净构建必须用 1：livox_laser_simulation（第三方副本，
                                    # 不能改）缺 add_dependencies 到自己的消息生成目标，并行必竞态
                                    # （fatal error: livox_laser_simulation/CustomMsg.h）。
                                    # 增量构建（消息头已在 devel）可安全提到 2~4 提速。
SLIM=0                               # 1 = 只编仿真需要的包（省掉 fast_gicp / SCAN 五包 / 真机驱动）

# ---- 宿主机用户映射（避免容器写出的文件变成 root 属主）----
# 取值：宿主机执行 `id -u` / `id -g`
HOST_UID=1000
HOST_GID=1000

# ---- 构建期代理（默认留空 = 国内源直连，更快更稳）----
# ★ 变量名故意不叫 HTTP_PROXY！如果叫 HTTP_PROXY，compose 会把调用方 shell 里的
#   代理顺手继承进构建容器 —— 而 shell 里的 http://127.0.0.1:xxxx 在构建容器内
#   根本不存在 ⇒ apt 全部 Connection refused ⇒ 满屏 "Unable to locate package"，
#   极易误判成"镜像/源坏了"。（2026-10-17 实测踩坑，Dockerfile 里已加 FATAL 自检。）
# 只有换回官方 ros: 基础镜像（源在国外）时才需要显式设，且必须填宿主机局域网 IP。
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_NO_PROXY=localhost,127.0.0.1

# ---- ROS 网络口径 ----
ROS_PORT=11312                                    # roscore 监听端口（项目惯例 11312）
ROS1_MASTER_URI=http://roscore:11312              # bridge 模式：走 compose DNS
ROS1_IP=                                          # bridge 模式留空（自动用 hostname）
HOST_IP=192.168.1.103                             # hostnet 模式下的本机 IP（真机=103）

# ---- GUI（rviz / gzclient，可选）----
DISPLAY=:0
