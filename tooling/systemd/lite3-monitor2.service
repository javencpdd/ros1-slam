[Unit]
Description=Lite3 Robot Monitor (UDP 43897 旁路抓包 → WebSocket 监控面板)
Documentation=file:/home/test/monitor2/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ysc
Group=ysc

# 旁路抓包（AF_PACKET）需要 CAP_NET_RAW。
# 用 AmbientCapabilities 而不是直接跑 root，遵循最小权限原则。
# 若你的 systemd / 内核版本不支持该写法，把上面两行改成 User=root 即可。
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

WorkingDirectory=/home/test/monitor2/backend

# ---- 运行参数 ----
Environment=PYTHONUNBUFFERED=1
# 依赖若以 pip --user 装在 ~/.local，必须让 site 模块能找到它
Environment=HOME=/home/ysc
Environment=PYTHONPATH=/home/test/monitor2/backend
# sniff = 旁路抓包，不占用 UDP 43897，不影响 transfer_ros2 收包
Environment=LITE3_UDP_MODE=sniff
Environment=LITE3_UDP_PORT=43897
# 指定只抓业务网网卡可显著降低无关流量，例如 eth0；留空表示所有网卡
Environment=LITE3_UDP_IFACE=
Environment=LITE3_HTTP_HOST=0.0.0.0
Environment=LITE3_HTTP_PORT=8002
Environment=LITE3_ROS_BRIDGE_PORT=43902
Environment=LITE3_PUSH_HZ=10
Environment=LITE3_LINK_TIMEOUT=3.0
Environment=LITE3_LOG_LEVEL=INFO

# /home/test/monitor2/.venv/bin/python 由 install.sh 替换为实际解释器（虚拟环境或系统 Python）
ExecStart=/home/test/monitor2/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8002

# 监控属于常驻服务，异常应自愈（区别于巡检任务，巡检禁止自动重启）
Restart=on-failure
RestartSec=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lite3-monitor

[Install]
WantedBy=multi-user.target
