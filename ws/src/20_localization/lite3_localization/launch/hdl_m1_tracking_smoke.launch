<?xml version="1.0"?>
<launch>
  <!-- A6 native tracking shell: hdl_localization only (no BBS node, no /relocalize).
       Candidates are supplied externally; the native reset path is /initialpose.
       Third-party launch/config files are not modified. -->
  <arg name="nodelet_manager" default="velodyne_nodelet_manager"/>
  <arg name="map_pcd" default="/opt/ros1-slam/data/maps/m1_world_synth_v1.pcd"/>
  <arg name="init_x" default="0.0"/>
  <arg name="init_y" default="0.0"/>
  <arg name="odom_child_frame_id" default="base_link"/>

  <node pkg="nodelet" type="nodelet" name="$(arg nodelet_manager)" args="manager" output="screen"/>
  <node pkg="nodelet" type="nodelet" name="globalmap_server_nodelet"
        args="load hdl_localization/GlobalmapServerNodelet $(arg nodelet_manager) --no-bond">
    <param name="globalmap_pcd" value="$(arg map_pcd)"/>
    <param name="convert_utm_to_local" value="false"/>
    <param name="downsample_resolution" value="0.1"/>
  </node>
  <node pkg="nodelet" type="nodelet" name="hdl_localization_nodelet"
        args="load hdl_localization/HdlLocalizationNodelet $(arg nodelet_manager) --no-bond">
    <remap from="/odom" to="/hdl_odom"/>
    <remap from="/tf" to="/hdl_native/tf"/>
    <remap from="/tf_static" to="/hdl_native/tf_static"/>
    <param name="lidar_timeout_ms" value="9999"/>
    <param name="imu_timeout_ms" value="9999"/>
    <param name="odom_child_frame_id" value="$(arg odom_child_frame_id)"/>
    <param name="use_imu" value="false"/>
    <param name="enable_robot_odometry_prediction" value="false"/>
    <param name="cool_time_duration" value="1.0"/>
    <param name="reg_method" value="NDT_OMP"/>
    <param name="ndt_neighbor_search_method" value="DIRECT1"/>
    <param name="ndt_neighbor_search_radius" value="3.0"/>
    <param name="ndt_resolution" value="1.0"/>
    <param name="downsample_resolution" value="0.3"/>
    <param name="specify_init_pose" value="true"/>
    <param name="init_pos_x" value="$(arg init_x)"/>
    <param name="init_pos_y" value="$(arg init_y)"/>
    <param name="init_pos_z" value="0.0"/>
    <param name="init_ori_w" value="1.0"/>
    <param name="init_ori_x" value="0.0"/>
    <param name="init_ori_y" value="0.0"/>
    <param name="init_ori_z" value="0.0"/>
    <param name="use_global_localization" value="false"/>
  </node>
</launch>
