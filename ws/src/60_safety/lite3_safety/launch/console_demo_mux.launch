<launch>
  <!-- Console demo-only safety mux. Uses config/cmd_vel_mux_demo.yaml
       (max_linear 1.0 m/s, speed_cap_required false) so interactive teleop can
       reach 1 m/s in the headless demo. Formal / real-robot launches must keep
       60_safety.launch + cmd_vel_mux.yaml. -->
  <node pkg="lite3_safety" type="safe_cmd_vel_mux.py" name="safe_cmd_vel_mux" output="screen">
    <param name="mux_config" value="$(find lite3_safety)/config/cmd_vel_mux_demo.yaml"/>
  </node>
  <node pkg="rostopic" type="rostopic" name="liveness_m6" args="pub -r 1 /lite3/liveness/m6_safety std_msgs/Empty"/>
</launch>
