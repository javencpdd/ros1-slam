<?xml version="1.0"?>
<package format="3">
  <name>lite3_navigation</name>
  <version>0.1.0</version>
  <description>lite3 shell package (M4) - self-owned launch/config/scripts only</description>
  <maintainer email="ros1-slam@lite3.local">ysc</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>catkin</buildtool_depend>
  <!-- move_base backend and plugins directly selected by launch/config. -->
  <exec_depend>move_base</exec_depend>
  <exec_depend>global_planner</exec_depend>
  <exec_depend>teb_local_planner</exec_depend>
  <exec_depend>costmap_2d</exec_depend>
  <exec_depend>costmap_converter</exec_depend>
  <exec_depend>lite3_costmap_layers</exec_depend>
  <!-- Legacy SUP heartbeat and optional visualization. -->
  <exec_depend>rostopic</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rviz</exec_depend>
  <!-- 三枚导航插件由本包 config 的 plugin 类型直接点名：global/local_costmap_params.yaml 的
       spatio_temporal_voxel_layer/SpatioTemporalVoxelLayer 与 sob_layer::SobLayer、mbf_navigation.yaml 的
       dwa_local_planner/DWAPlannerROS。此前任何 package.xml 均未声明，镜像缺装时 mbf_costmap_nav 抛
       pluginlib::LibraryLoadException 直接 exit -6（2026-10-17 x86 侧实测）。真人裁决归「依赖声明类」
       常设授权：只回写声明，不改任何数值与判据语义。 -->
  <exec_depend>dwa_local_planner</exec_depend>
  <exec_depend>base_local_planner</exec_depend>
  <exec_depend>mpc_local_planner</exec_depend>
  <exec_depend>navfn</exec_depend>
  <exec_depend>spatio_temporal_voxel_layer</exec_depend>
  <exec_depend>sob_layer</exec_depend>
</package>
