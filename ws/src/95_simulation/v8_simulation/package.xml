<?xml version="1.0"?>
<package format="2">
  <name>v8_simulation</name>
  <version>0.1.0</version>
  <description>Explicit simulation entry points for v8 carriers and verification backends; source-space compatibility with v8_platform.</description>
  <maintainer email="dev@example.com">ros1-slam</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>v8_platform</exec_depend>
  <exec_depend>lite3_gazebo_sim</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <export>
    <architecture_independent/>
  </export>
</package>
