<launch>
  <!-- m1_gazebo.launch —— M1 仿真台：headless Gazebo + planar 伪狗 + sim_adapter CustomMsg 分支
       （小张 payload，2026-10-05）。headless 实现：empty_world.launch gui:=false → 只起 gzserver。
       前置：fratopa 包 livox_laser_simulation 原样复制进 ws/src 并 catkin build（见 04 台账 D-02）。 -->
  <arg name="gui" default="false"/>
  <arg name="payload_dir" default="$(find lite3_gazebo_sim)"/>
  <arg name="world" default="$(arg payload_dir)/worlds/m1_world.world"/>

  <!-- use_sim_time 贯穿（Gazebo 为唯一时钟源 /clock） -->
  <param name="use_sim_time" value="true"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
    <arg name="verbose" value="false"/>
  </include>

  <!-- 机器人：xacro → robot_description → spawn（z=0.15：TORSO box 底面 -0.11，落地间隙 0.04m） -->
  <param name="robot_description" command="$(find xacro)/xacro $(arg payload_dir)/urdf/lite3_planar.urdf.xacro"/>
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>
  <node name="spawn_lite3_planar" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -param robot_description -model lite3_planar -x 0 -y 0 -z 0.15"/>

  <!-- ★R572（批224）：帧口径钉死 map，由本恒等桥供给★
       先例＝m2_teb.launch:31-32。本台原本只有 odom→base_link→rslidar，独缺 map；而消费侧
       global_frame=map、高程生产者 grid_frame=map ⇒ 桥不在即整段 INVALID（R572 已退役「退到 odom」分支）。
       ★无定位节点的占位桥，真定位接入时不起★——凡本台引入 hdl／faster_lio 等发 map 系的节点，
       必须注释掉本节点；下面的 tf_frame_assert 是它的在位闸。 -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_odom_static"
        args="0 0 0 0 0 0 map odom"/>

  <!-- 父边唯一断言（R572 新建）：odom 父帧唯一且＝map、map 帧可达；结论写 /tf_frame_assert/ok -->
  <node pkg="lite3_gazebo_sim" type="tf_frame_assert.py" name="tf_frame_assert" output="screen">
    <param name="protected_child" value="odom"/>
    <param name="expect_parent" value="map"/>
    <param name="observe_sec" value="3.0"/>
    <param name="timeout" value="30.0"/>
  </node>

  <!-- sim_adapter（Gazebo 变体）：
       参数 input=custommsg：吃 fratopa /livox/lidar（livox_laser_simulation/CustomMsg）→ /rslidar_points（C16 契约布局不变）
       参数 no-imu：/livox/imu 由 Gazebo IMU 插件直发（200Hz 真传感器语义），不再由位姿差分合成（④） -->
  <node name="sim_adapter" pkg="lite3_drivers" type="sim_adapter.py"
        args="--input custommsg --no-imu --rate-lidar 10" output="screen"/>

</launch>
