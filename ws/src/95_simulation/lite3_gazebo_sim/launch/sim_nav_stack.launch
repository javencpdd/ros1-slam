<launch>
  <!-- 平地/斜坡仿真导航栈（正式链路，不依赖临时测试脚本）

       数据流：
         /sim/odom_gt  =>[sim_pose_source]=>  /v8/local/pose + /v8/global/start(0.5 Hz)
         map_single_floor.json  =>[v8_map_file]=>  /v8_support_map（latch）
         /v8/bt/goal  =>[bt_console]=>  /v8/global/goal(直发)  =>[v8_global_planner]=>  /global_path
         /global_path  =>[v8_path_goal]=>  /v8/local/goal
         /v8/local/pose + /v8/local/goal  =>[v8_local_planner]=>  /cmd_vel  =>  Gazebo 载体

       前置：sim_m1 栈已在跑（Gazebo + 载体 + /sim/odom_gt）。
       ★本栈只用于平地/斜坡；不做上下楼（四例见 note/进度/v8 的 R1127 口径）。★
       载体 mu1/mu2=0.1 属判据受控条件，本栈不修改。 -->
  <arg name="enable_bt" default="true"/>
  <arg name="bt_profile" default="demo"/>
  <arg name="zmq_pub_port" default="5555"/>
  <arg name="zmq_sub_port" default="5556"/>
  <arg name="local_twist_topic" default="/cmd_vel"/>

  <!-- 1) 真值位姿 -> 契约话题。占位桥：真定位接入时应停用本节点。
       start 低频喂全局规划器（topic_node 需要 map+start+goal 三输入）。 -->
  <node pkg="lite3_gazebo_sim" type="sim_pose_source.py" name="sim_pose_source" output="screen">
    <param name="src_topic" value="/sim/odom_gt"/>
    <param name="dst_topic" value="/v8/local/pose"/>
    <param name="frame_id" value="map"/>
    <param name="z_offset" value="-0.11"/>
    <param name="rate" value="50.0"/>
    <param name="start_topic" value="/v8/global/start"/>
    <param name="start_rate" value="0.5"/>
    <!-- 局部规划器按 input_max_age_s(默认 1.0 s) 判定位是否新鲜，必须远快于它，
         否则会在边界上反复判 stale(E_LOCAL_LOCALIZATION) 而拒发速度。 -->
    <param name="localization_ok_period_s" value="0.2"/>
  </node>

  <!-- 2) 障碍物心跳。局部规划器在 obstacles stale 时拒发速度；本栈没有感知
       生产者，故由仿真侧按契约发"无障碍"预测（可用 payload 注入真实盒）。
       ★26-11-11 补★ rate 必须按 RTF 留余量：rospy.Timer(Duration) 走仿真时钟，
       实测本机 RTF≈0.45 ⇒ sim 2Hz 折算墙钟只有 0.9Hz，超过 freshness 的墙钟
       max_age(1.0 s)，E_LOCAL_OBSTACLES_STALE 由此而来（input_ages 证实年龄
       周期性爬过 1.0）。位姿 50 Hz/定位 0.2 s 因频率高而幸免。提到 sim 10 Hz
       ⇒ RTF 0.45 时墙钟 4.5 Hz、年龄 ≤0.22 s；RTF 低到 0.2 也仍有 1 s 裕度。 -->
  <node pkg="lite3_gazebo_sim" type="sim_empty_obstacles.py" name="sim_empty_obstacles"
        output="screen">
    <param name="topic" value="/v8/local/obstacles"/>
    <param name="rate" value="10.0"/>
  </node>

  <!-- 3) 支撑图发布：正式节点 framework/map_file_node.py（latch 发布）。
       ★26-11-11 补★ 之前端到端测试的 map 是临时手段喂的；测试脚本删除后
       本栈一直没人发 /v8_support_map ⇒ local_planner 的 shared['map']=None，
       主循环在 map 为空处空转、永不覆盖 last_error，启动瞬间 obstacles
       未连上时写入的 E_LOCAL_OBSTACLES_STALE 残值被 status 永久展示
       （input_ages 证实 obstacles 实际 0.58s 新鲜）。map 缺失才是根因。
       平地场景用 single_floor 夹具；斜坡场景须换与 world 同源的支撑图。 -->
  <node pkg="v8_platform" type="run_map_file.py" name="v8_map_file" output="screen">
    <param name="map_json" value="$(find v8_platform)/contracts/fixtures/map_single_floor.json"/>
    <param name="map_topic" value="/v8_support_map"/>
  </node>

  <!-- 4) 全局规划器：默认订阅 /v8/global/goal（demo 链 BT 直发口）＋ /v8/global/start
       ＋ /v8_support_map -> /global_path。注意 bt_console 的 RequestPath 直发
       planner_goal_topic(=/v8/global/goal)；goal_gate 的 /v8/3d/global/goal 门控
       通路是给真机 profile 用的（真机把 planner_goal_topic 指到 goal_request），
       仿真 demo 不走 gate，不要把规划器订阅改到 /v8/3d/global/goal（实测会断链）。 -->
  <node pkg="v8_platform" type="run_global_planner.py" name="v8_global_planner" output="screen"/>

  <!-- 5) 全局路径 -> 局部目标（取路径上的跟踪点，不给速度） -->
  <node pkg="v8_platform" type="run_path_goal.py" name="v8_path_goal" output="screen">
    <param name="path_topic" value="/global_path"/>
    <param name="goal_topic" value="/v8/local/goal"/>
  </node>

  <!-- 6) 局部规划器：位姿 + 局部目标 -> Twist（正式执行链，替代测试脚本的比例控制） -->
  <node pkg="v8_platform" type="run_local_planner.py" name="v8_local_planner" output="screen">
    <param name="pose_topic" value="/v8/local/pose"/>
    <param name="goal_topic" value="/v8/local/goal"/>
    <param name="map_topic" value="/v8_support_map"/>
    <param name="twist_topic" value="$(arg local_twist_topic)"/>
    <!-- support_tol_m 默认 1e-6（微米级）：要求位姿 z 精确等于地图 z_reference。
         仿真载体是方盒、位姿取模型中心 z≈0.11，而支撑面 z_reference=0，差 0.11 m
         就被判 E_LOCAL_SUPPORT 而拒发速度。这里按"脚底接触高度带"的本意放宽到 0.25。 -->
    <rosparam param="experimental_config">{support_tol_m: 0.25}</rosparam>
  </node>

  <!-- 7) 编排层：Nav2 式 BT + goal gate -->
  <group if="$(arg enable_bt)">
    <include file="$(find lite3_bt)/launch/bt_console.launch">
      <arg name="profile" value="$(arg bt_profile)"/>
      <arg name="zmq_pub_port" value="$(arg zmq_pub_port)"/>
      <arg name="zmq_sub_port" value="$(arg zmq_sub_port)"/>
    </include>
  </group>
</launch>
