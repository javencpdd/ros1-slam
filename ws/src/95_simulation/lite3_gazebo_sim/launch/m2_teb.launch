<launch>
  <!-- m2_teb.launch —— M2-2 teb 物理闭环（小张 payload，2026-10-06）
       链路：gazebo(M2 xacro) → lite3_planar_drive 吃速度指令话题（M1 已证该话题可驱动机体）
             → costmap 障碍层实时吃 /rslidar_points（C3 终值）+ static_layer 吃 m2_free_map 免费底图
             → mbf（C0 形态，cmd_vel 已 remap cmd_vel_raw）→ m2_cmd_relay /cmd_vel_raw→/cmd_vel 闭环。
       TF：map→odom 恒等（static）+ odom→base_link（lite3_planar_drive 闭环发布）→ map→base_link 可查。
       红线：全链 11313 隔离域（调用方设）；速度指令话题写者唯一=m2_cmd_relay（本 sim 域，无 M6/SUP）；
             无 ros2qnx、无估计层之外的真机组件；不触生产 11312。 -->
  <arg name="goal_x" default="3.0"/>   <!-- 冒烟判据：起点 +3m -->
  <arg name="goal_y" default="0.0"/>
  <param name="use_sim_time" value="true"/>

  <include file="$(find lite3_gazebo_sim)/launch/m2_gazebo.launch"/>

  <!-- map→odom 恒等桥（mapless rolling costmap；真实定位接入= M2-3 hdl，本 stage 不起）
       [M2R3 2026-10-08 主理人采纳小张 §0] tf_source 缺省 fresh：静态件进 tf2 static 专用缓存、
         语义「对所有时刻恒真」，lookupTransform(Time(0)) 在动态段未入缓存时回退到静态段零时刻
         锚点 ⇒ 组合结果 stamp=Time(0) ⇒ mbf 保鲜校验 Δ_age = t_sim_now（实测 21.491s vs tol 3s）
         ⇒ teb 立即 ABORT(state=4/dt=0)；且 canTransform 在静态链上恒 True ⇒ 旧门控 G1–G4 失明。
         fresh 分支只改时间基（每次带 rospy.Time.now()），几何与静态件逐字相同、节点数与启动
         次序不变。tf_source:=static 为阴性对照回退口，专供复验证明 G5 确有分辨力，非生产用法。 -->
  <arg name="tf_source" default="fresh"/>
  <group if="$(eval arg('tf_source') == 'fresh')">
    <node pkg="lite3_gazebo_sim" type="m2_tf_fresh.py" name="m2_tf_fresh" output="screen">
      <param name="rate_hz"     value="10.0"/>
      <param name="parent_frame" value="map"/>
      <param name="child_frame"  value="odom"/>
    </node>
  </group>
  <group unless="$(eval arg('tf_source') == 'fresh')">
    <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_odom_static"
          args="0 0 0 0 0 0 map odom"/>
  </group>

  <node pkg="lite3_gazebo_sim" type="m2_free_map.py" name="m2_free_map"/>
  <node pkg="lite3_gazebo_sim" type="m2_cmd_relay.py" name="m2_cmd_relay"
        args="/cmd_vel_raw /cmd_vel Twist"/>

  <!-- mbf 导航栈的 include 已上收至 TOP 编排层：lite3_bringup/launch/mode_sim_teb.launch
       （[5] 返工 2026-10-08，设计=小张路 A；K3 禁平级 lite3_* 互 include，sim 壳包不伸手进生产模块。
        起 stageB 请用 TOP 入口，勿再直接 roslaunch 本文件。） -->

  <!-- 目标注入：mbf move_base action（mbf_msgs/MoveBaseAction）；goal 由冒烟脚本按 start 动态发，
       此处仅登记约定 goal=(start_x+3, start_y) —— 判据 ≤0.35m / ≤120s（sim 时）见 m2_smoke.sh Stage B -->
</launch>
