<?xml version="1.0"?>
<!--
  lite3_planar.urdf.xacro —— M2 版（小张 payload，2026-10-06；M1 版逐字保留 fratopa/IMU/骨架三块，仅换驱动插件块）
  M2-1 修法 B：planar_move（系统 .so，odom yaw 开环积分）→ lite3_planar_drive（自研壳插件，src/lite3_planar_drive.cpp）：
    ① /Odometry 与 odom→base_link TF 一律 WorldPose 闭环（废除 cmd 积分开环 yaw——M1 turn/back 错位根因）；
    ② 线速度按模型朝向 RotateVector（体速度语义）；
    ③ driveMode=kinematic 时 SetWorldPose 运动学直推（探针判 H2「物理不可转」时用此模式）；
    ④ cmdTimeout 零速兜底。
  回退：driveMode 改回/换回 filename="libgazebo_ros_planar_move.so" 即回 M1 形态（无文件回滚需求）。
  其余块与 M1 版逐字相同（取舍声明①②③、fratopa 参数逐字照 README、IMU 200Hz、mu 0.1），未重述。
  M2R5/U1：仅关节块拓扑方向变（torso_to_base → base_to_torso，parent/child 互换），origin 恒等、
           几何/inertial/sensor/plugin/mu 五块逐字未动 ⇒ 语义等价，只消除 base_link 双父（设计件
           note/进度/M2/设计/m2r5_双父TF设计.md 方案 A）。
-->
<robot name="lite3_planar" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="lidar_z" value="0.38"/><xacro:property name="lidar_pitch" value="0"/><!-- ★R403 甲′（Q-B1 载体竖向旋钮、★缺省＝原字面值 ⇒ 行为零改动）。下一步（乙）若对齐真机口径 h≈0.45 m／θ≈15°（R310）只改本行两值，俯仰★必须写成 ${radians(度数)}——rpy 单位是弧度，填字面 15 会被当 15 弧度。验收式＝只排 xacro 横幅行不够（行内注释也进展开体），须解析 XML 比结构签名。★本行刻意占掉原空行＝零插入行、★不顶走任何在册行号引用（note/02 坑61／追加三十九）。 -->
  <!-- ================= 官方骨架：TORSO（保持官方名；M2R5 起非 root，恒等挂于 base_link 下） ================= -->
  <link name="TORSO">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="15.0"/>
      <inertia ixx="0.3406" iyy="0.1806" izz="0.2810" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.42 0.31 0.22"/></geometry>
      <material name="torso_grey"><color rgba="0.35 0.35 0.4 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.42 0.31 0.22"/></geometry>
    </collision>
  </link>

  <!-- [M2R5/U1 2026-10-08 方案 A] 桥向反挂：原 torso_to_base（parent=TORSO/child=base_link）
       使 base_link 在 tf2 图里同时有静态父 TORSO 与动态父 odom（插件 lite3_planar_drive.cpp:127 发
       odom→base_link），双父 ⇒ tf2 查询 odom→base_link 命中静态缓存被规范化的 Time(0)，
       表现为 harness G5c1 零戳（E3 直读实证原始消息戳是新鲜的）。反挂后 base_link 为唯一 root、
       静态面只剩 base_link→{TORSO, rslidar}。恒等原点与「双 frame 并存」意图逐字保留。 -->
  <joint name="base_to_torso" type="fixed">
    <parent link="base_link"/>
    <child link="TORSO"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="base_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="base_to_rslidar" type="fixed">
    <parent link="base_link"/>
    <child link="rslidar"/>
    <origin xyz="0 0 ${lidar_z}" rpy="${lidar_pitch} 0 0"/>   <!-- ★R403 甲′：展开值＝原字面 0.38／0，行为不变 -->
  </joint>
  <link name="rslidar">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.045" length="0.03"/></geometry>
      <material name="lidar_black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <!-- D-M1-5 取舍声明④：sensor 起点不得落于任何自身 collision 内——collision 整块删除（M1 返工 R1 已收口），仅注释留位 -->
  </link>

  <!-- ================= fratopa Mid360（参数逐字照 README，type=3 → CustomMsg） ================= -->
  <gazebo reference="rslidar">
    <sensor type="ray" name="laser_livox">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <plugin name="livox_mid360_plugin" filename="liblivox_laser_simulation.so">
        <ray>
          <scan>
            <horizontal>
              <samples>100</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415926535897931</min_angle>
              <max_angle>3.1415926535897931</max_angle>
            </horizontal>
            <vertical>
              <samples>50</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415926535897931</min_angle>
              <max_angle>3.1415926535897931</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>40</max>
            <resolution>1</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.0</stddev>
          </noise>
        </ray>
        <visualize>false</visualize>
        <samples>20000</samples>
        <downsample>1</downsample>
        <csv_file_name>mid360-real-centr.csv</csv_file_name>
        <publish_pointcloud_type>3</publish_pointcloud_type>
        <ros_topic>/livox/lidar</ros_topic>
        <frameName>rslidar</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ================= Gazebo IMU 200Hz（/livox/imu，faster_lio imu_topic 契约） ================= -->
  <gazebo reference="rslidar">
    <sensor type="imu" name="mid360_imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <plugin name="gazebo_ros_imu_sensor" filename="libgazebo_ros_imu_sensor.so">
        <alwaysOn>true</alwaysOn>
        <updateRateHZ>200</updateRateHZ>
        <bodyName>rslidar</bodyName>
        <frameName>rslidar</frameName>
        <topicName>/livox/imu</topicName>
        <gaussianNoise>0.01</gaussianNoise>
        <xyzOffset>0 0 0</xyzOffset>
        <rpyOffset>0 0 0</rpyOffset>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ================= M2-1 修法 B：lite3_planar_drive（自研壳插件） =================
       落位：lite3_gazebo_sim/src/lite3_planar_drive.cpp，编译产出 liblite3_planar_drive.so（GAZEBO_PLUGIN_PATH 随 ws devel）。
       driveMode 装配默认 kinematic —— 探针 M2-1-D 若判 H1（物理可转）则改 dynamic（保留碰撞物理）；
       判 H2（物理不可转）维持 kinematic。两模式 odom/TF 均为 WorldPose 闭环。 -->
  <gazebo>
    <plugin name="lite3_planar_drive" filename="liblite3_planar_drive.so">
      <robotNamespace>/</robotNamespace>
      <commandTopic>cmd_vel</commandTopic>
      <!-- [批1/F-D 2026-10-08] 让位：/Odometry 归 faster_lio 单写（laser_mapping.cc:265 绝对名），
           本插件的世界位里程计改发 /sim/odom_gt —— 二者此前同发 /Odometry 构成双写者，
           使 stageA/C 的 M2-1/M2-4 判据位姿源不可归因（02 坑26，实测证据 fd2_pre_baseline/）。
           名字带 _gt 是刻意的：它语义上就是 WorldPose 真值，不得冒充估计量。
           odometryFrame=odom 与 robotBaseFrame=base_link **不动**（护住 M2R5/U1 的单父拓扑与 E3/G5c1 锚）。 -->
      <odometryTopic>/sim/odom_gt</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_link</robotBaseFrame>
      <driveMode>dynamic</driveMode>
      <cmdTimeout>10.0</cmdTimeout>
      <odometryRate>50</odometryRate>
    </plugin>
  </gazebo>

  <gazebo reference="TORSO">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>

</robot>
