<launch>
  <!-- mode_sim_hdl.launch —— M2 stageC 的 TOP 层编排件（[5] 返工，主理人执行 2026-10-08；设计=小张 §0/§1 路 A）
       为何存在：m2_hdl.launch 原先直接 include lite3_localization = sim 壳包伸手进生产模块
                 （共同门禁 [5] 真命中之二）。上收到 TOP 编排层 lite3_bringup（P7 裁决先例同构）。
       等价性声明：sim 侧只删该 include 块、其余原样（gazebo include + imu_relay 保留）；
                 四个 arg（map_name / points_topic / manager_required / clock_gate_cmd）逐字照搬；
                 节点启动次序不变（gazebo→imu_relay→hdl）；use_sim_time 仍解析为 /use_sim_time。
       风险注记：hdl 的**仿真验证**已被 M2-R2C 裁决终止（manager SIGSEGV，转真机 G8 顺带验证），
                 本文件属「低风险纯搬运」——不改变 hdl 在仿真域不可用的既有结论，也不重启该实验。 -->
  <arg name="map_name" default="sim_venue"/>

  <include file="$(find lite3_gazebo_sim)/launch/m2_hdl.launch">
    <arg name="map_name" value="$(arg map_name)"/>
  </include>

  <!-- ↓↓ 自 m2_hdl.launch:16-22 逐字搬来（[5] 返工），内容一字未改 ↓↓ -->
  <include file="$(find lite3_localization)/launch/hdl_localization.launch">
    <arg name="map_name" value="$(arg map_name)"/>
    <arg name="points_topic" value="/rslidar_points"/>
    <!-- ★关掉 HDL 的重复外参发布★（2026-11-27 真人裁定，纠正 2026-11-24 的错误假设）：
         上一版这里写"仿真里 URDF 没有 rslidar 这一节关节"，**与事实相反**——
         `lite3_gazebo_sim/urdf/lite3_planar.urdf.xacro:55-59` 有 base_to_rslidar，
         z=0.34、pitch=15°，由 robot_state_publisher 发布，这是 R409 定下的真实安装几何。
         于是同一条 (base_link→rslidar) 被两处发布、值不同，/tf_static 后到者覆盖，
         点云平移在 0 与 0.34 m 之间翻转。唯一权威＝URDF 与 R409 裁决，
         所以这里传 publish_extrinsic:=false 关掉本节点的外参发布（参数语义见
         lite3_localization/launch/hdl_localization.launch:36-39），不再给恒等值。 -->
    <arg name="publish_extrinsic" value="false"/>
    <!-- 四个 arg 在 hdl_localization.launch:39-42 声明为**无缺省**（roslaunch 要求必给），
         所以仍要传；但取值一律对齐 URDF 真值，避免"关掉发布却留着假值"这种二次踩坑：
         tf_pitch 单位是**弧度**（static_transform_publisher 的 yaw/pitch/roll 槽），
         15° = 0.2617993877991494，与 xacro 展开值逐位一致。 -->
    <arg name="tf_x" value="0.0"/>
    <arg name="tf_y" value="0.0"/>
    <arg name="tf_z" value="0.34"/>
    <arg name="tf_pitch" value="0.2617993877991494"/>
    <!-- M2-R2C（小张 R2C manifest 施工件3）：/clock 门控 + manager required 仅仿真域启用；真机 G8 不传=缺省现行为 -->
    <arg name="manager_required" value="true"/>
    <arg name="clock_gate_cmd" value="$(find lite3_gazebo_sim)/scripts/wait_sim_clock.sh"/>
  </include>
</launch>
