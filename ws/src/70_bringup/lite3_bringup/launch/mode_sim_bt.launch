<launch>
  <!-- 平地仿真 BT+自研导航链（mode_sim_bt）——2026-11-21，取消 MBF 后平地判据链的 BT 继任者。

       背景：2026-11-21 真人拍板「取消 MBF，全走 BT+自研」；设计见
       note/架构/MBF吸收与导航链重构.md。本 launch 是 21c0a302 退役的
       sim_nav_stack.launch 的单写者重建版：
         · 旧件直写 /cmd_vel（K2 违规）⇒ 本件局部规划器 twist 镜像投 /cmd_vel_raw，
           经 m2_cmd_relay（/cmd_vel_raw → /cmd_vel）转发，/cmd_vel 仍只有 relay 一个写者。
         · 世界与工具链复用 m2_teb.launch（m2_gazebo + 新鲜 TF + free map + cmd relay）。

       数据流：
         /sim/odom_gt  =>[sim_pose_source]=>  /v8/local/pose + /v8/global/start(0.5 Hz)
         map_single_floor.json  =>[v8_map_file]=>  /v8_support_map（latch）
         /v8/bt/goal  =>[bt_console RequestPath]=>  /v8/global/goal  =>[v8_global_planner]=>  /global_path
         /global_path  =>[v8_path_goal]=>  /v8/local/goal
         /v8/local/pose + /v8/local/goal  =>[v8_local_planner]=>  /v8/local/cmd（3D）
           ＋ twist 镜像 /cmd_vel_raw  =>[m2_cmd_relay]=>  /cmd_vel  =>  lite3_planar_drive

       用途：m2 smoke Stage B 迁移后的判据执行链；平地 BT 回归。
       边界：不做上下楼（多层见 two_floor_nav.py 的 orchestrator=bt 模式）；不触真机。 -->
  <arg name="enable_bt" default="true"/>
  <arg name="bt_profile" default="demo"/>
  <arg name="zmq_pub_port" default="5555"/>
  <arg name="zmq_sub_port" default="5556"/>
  <arg name="local_twist_topic" default="/cmd_vel_raw"/>
  <arg name="map_json" default="$(find v8_platform)/contracts/fixtures/map_single_floor.json"/>
  <!-- 透传给 m2_teb 的 TF 阴性对照口子（G5c1/TF 结构门标定用；缺省 fresh）。 -->
  <arg name="tf_source" default="fresh"/>
  <!-- 全局后端二选一（T-20261122-02 R4）：support 走本仓支撑图规划器（缺省），
       far 走第三方 FAR overlay。同一棵 BT、同一条安全链、同一个局部规划器，只换全局那一节。 -->
  <arg name="global_backend" default="support"/>
  <!-- 外部到达信号（std_msgs/Bool）。空＝BT 用位姿判据；far 后端必须显式给，
       否则 far 的到达自报发出来也没人听，BT 仍按 xy 距离判，多层场景会提前成功。 -->
  <arg name="arrival_topic" default=""/>
  <!-- far 后端的诊断开关（上游 is_debug_output）：平时关，排查图不收敛时打真值输出。 -->
  <arg name="far_debug" default="false"/>
  <!-- 地形点是否压到地面（true＝CMU terrain_map 形态）。对照实验用。 -->
  <arg name="far_terrain_flatten" default="true"/>

  <!-- 1) 仿真底座：m2_gazebo（world+载体+传感器）＋新鲜 TF＋free map＋cmd relay。
       m2_teb.launch 自 2026-10-08 [5] 返工后已不含 MBF（MBF include 上收到 TOP 层），
       这里只复用它不含 MBF 的底座部分。 -->
  <include file="$(find lite3_gazebo_sim)/launch/m2_teb.launch">
    <arg name="tf_source" value="$(arg tf_source)"/>
  </include>

  <!-- 2) 真值位姿 -> 契约话题（同 21c0a302 退役件参数）。 -->
  <node pkg="lite3_gazebo_sim" type="sim_pose_source.py" name="sim_pose_source" output="screen">
    <param name="src_topic" value="/sim/odom_gt"/>
    <param name="dst_topic" value="/v8/local/pose"/>
    <param name="frame_id" value="map"/>
    <param name="z_offset" value="-0.11"/>
    <param name="rate" value="50.0"/>
    <param name="start_topic" value="/v8/global/start"/>
    <param name="start_rate" value="0.5"/>
    <param name="localization_ok_period_s" value="0.2"/>
  </node>

  <!-- 3) 障碍物心跳：局部规划器按新鲜度拒发，rate 按 RTF 余量取 sim 10 Hz。 -->
  <node pkg="lite3_gazebo_sim" type="sim_empty_obstacles.py" name="sim_empty_obstacles"
        output="screen">
    <param name="topic" value="/v8/local/obstacles"/>
    <param name="rate" value="10.0"/>
  </node>

  <!-- 4) 支撑图发布（平地夹具）。 -->
  <node pkg="v8_platform" type="run_map_file.py" name="v8_map_file" output="screen">
    <param name="map_json" value="$(arg map_json)"/>
    <param name="map_topic" value="/v8_support_map"/>
  </node>

  <!-- 5) 全局规划节：二选一（default=support，零回归）。
       support：本仓支撑图规划器，订阅 /v8/global/goal（demo 链 BT 直发口）＋ start ＋ map。
       far：第三方 FAR overlay，地形与航点由 run_global_far.py 转；参数与话题默认值
            在 far_stack.launch 里，且必须与 manifest_global_far.json 的 port topic 逐字相同。 -->
  <group if="$(eval arg('global_backend') == 'support')">
    <node pkg="v8_platform" type="run_global_planner.py" name="v8_global_planner" output="screen"/>
  </group>

  <group if="$(eval arg('global_backend') == 'far')">
    <include file="$(find v8_platform)/launch/far_stack.launch">
      <arg name="cloud_topic" value="/rslidar_points"/>
      <arg name="start_topic" value="/v8/local/pose"/>
      <arg name="goal_topic" value="/v8/global/goal"/>
      <arg name="path_topic" value="/global_path"/>
      <arg name="status_topic" value="/global_path/status"/>
      <arg name="arrival_topic" value="$(arg arrival_topic)"/>
      <arg name="debug_output" value="$(arg far_debug)"/>
      <arg name="terrain_flatten" value="$(arg far_terrain_flatten)"/>
    </include>
  </group>

  <!-- 6) 全局路径 -> 局部目标。两个后端共用：far 的 /global_path 也走这里。 -->
  <node pkg="v8_platform" type="run_path_goal.py" name="v8_path_goal" output="screen">
    <param name="path_topic" value="/global_path"/>
    <param name="goal_topic" value="/v8/local/goal"/>
  </node>

  <!-- 7) 局部规划器：位姿 + 局部目标 + 支撑图 -> 3D cmd；twist 镜像投 /cmd_vel_raw
       （单写者链：local_planner -> /cmd_vel_raw -> m2_cmd_relay -> /cmd_vel）。
       support_tol_m 放宽到 0.25：方盒载体位姿 z≈0.11 与支撑面 z_reference=0 的差
       属"脚底接触高度带"本意，与退役件同值。 -->
  <node pkg="v8_platform" type="run_local_planner.py" name="v8_local_planner" output="screen">
    <param name="pose_topic" value="/v8/local/pose"/>
    <param name="goal_topic" value="/v8/local/goal"/>
    <param name="map_topic" value="/v8_support_map"/>
    <param name="twist_topic" value="$(arg local_twist_topic)"/>
    <rosparam param="experimental_config">{support_tol_m: 0.25}</rosparam>
  </node>

  <!-- 8) 编排层：BT（demo profile 只含接线；物理量在树 XML 端口）。
       arrival_topic 必须在这一层透传：bt_console 的私有参数只能经 bt_console.launch 的 arg 送进去，
       同级的兄弟 group 里写 param 传不到节点（实读 bt_console.cpp:1228-1230 与启动日志那行判定）。 -->
  <group if="$(arg enable_bt)">
    <include file="$(find lite3_bt)/launch/bt_console.launch">
      <arg name="profile" value="$(arg bt_profile)"/>
      <arg name="zmq_pub_port" value="$(arg zmq_pub_port)"/>
      <arg name="zmq_sub_port" value="$(arg zmq_sub_port)"/>
      <arg name="arrival_topic" value="$(arg arrival_topic)"/>
    </include>
  </group>
</launch>
