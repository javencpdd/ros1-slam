<launch>
  <arg name="goal_x" default="3.0"/>
  <arg name="goal_y" default="0.0"/>
  <arg name="tf_source" default="fresh"/>
  <arg name="goal_topic" default="/v8/bt/goal"/>
  <arg name="local_planner" default="teb"/>
  <arg name="global_planner" default="global_planner"/>

  <include file="$(find lite3_gazebo_sim)/launch/m2_teb.launch">
    <arg name="goal_x" value="$(arg goal_x)"/>
    <arg name="goal_y" value="$(arg goal_y)"/>
    <arg name="tf_source" value="$(arg tf_source)"/>
    <arg name="cmd_relay" value="false"/>
  </include>
  <include file="$(find lite3_safety)/launch/60_safety.launch"/>
  <node pkg="lite3_gazebo_sim" type="sim_speed_cap.py" name="sim_speed_cap" output="screen">
    <param name="topic" value="/v8/safety/speed_cap"/>
    <param name="value" value="0.5"/>
    <param name="rate" value="2.0"/>
  </node>
  <arg name="elevation_source" default="native"/>
  <group if="$(eval arg('elevation_source') == 'native')">
    <node pkg="lite3_costmap_layers" type="elevation_gridmap_publisher.py" name="elevation_gridmap_publisher" output="screen">
      <param name="stale_timeout" value="1.0"/>
    </node>
  </group>
  <group if="$(eval arg('elevation_source') == 'elevation_mapping')">
    <node pkg="elevation_mapping" type="elevation_mapping" name="elevation_mapping" output="screen">
      <rosparam command="load" file="$(find lite3_costmap_layers)/config/elevation_mapping_sim.yaml"/>
    </node>
  </group>
  <!-- Sensor TTL is explicit and simulation-only; production must configure its own budget. -->
  <arg name="elevation_ttl_s" default="1.0"/>
  <param name="/navigation_executor/global_costmap/elevation_merged_layer/input_timeout_s" value="$(arg elevation_ttl_s)"/>
  <param name="/navigation_executor/local_costmap/elevation_merged_layer/input_timeout_s" value="$(arg elevation_ttl_s)"/>
  <include file="$(find lite3_navigation)/launch/navigation_executor.launch">
    <arg name="local_planner" value="$(arg local_planner)"/>
    <arg name="global_planner" value="$(arg global_planner)"/>
  </include>
  <include file="$(find lite3_bt)/launch/bt_navigation.launch">
    <arg name="goal_topic" value="$(arg goal_topic)"/>
  </include>
</launch>
