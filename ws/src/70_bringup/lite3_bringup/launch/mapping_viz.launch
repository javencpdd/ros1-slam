<launch>
  <!-- 采图可视化伴侣：累积地图快照 + Lite3 模型（供 Foxglove 观察建图过程） -->
  <!-- 用法：采图三窗之外第 4 窗 roslaunch lite3_bringup mapping_viz.launch -->
  <!-- Foxglove：固定参考系 camera_init；订阅 /map_snapshot（30s 一条全图快照）+ 3D 面板 URDF 模型自动跟随 /Odometry -->
  <param name="robot_description" textfile="/home/ros1-slam/ws/src/95_simulation/lite3_description/urdf/Lite3.urdf"/>

  <!-- 累积地图快照（30s 一条，latched） -->
  <node pkg="lite3_bringup" type="map_snapshot_pub.py" name="map_snapshot_pub" output="screen"/>

  <!-- Lite3 模型：关节默认站姿 + robot_state_publisher 出全机 TF（body→TORSO 恒等桥接 faster_lio 的 body 帧） -->
  <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
    <param name="publish_frequency" value="20.0"/>
  </node>
  <node pkg="tf2_ros" type="static_transform_publisher" name="body_to_torso"
        args="0 0 0 0 0 0 body TORSO"/>
</launch>
