<?xml version="1.0"?>
<!-- Nav2-style orchestration tree.
     The tree owns WHEN: goal -> localization check -> path -> follow -> arrival
     -> dwell -> stop.  A cancel branch runs before recovery; recovery is
     configurable by the node (skip/retry/replan/abort). -->
<root main_tree_to_execute="NavigateWithPlanner">
  <BehaviorTree ID="NavigateWithPlanner">
    <Fallback name="mission_or_cancel_or_recovery">
      <Sequence name="mission">
        <IsNotCancelled name="not_cancelled"/>
        <WaitForGoal name="wait_goal"/>
        <CheckLocalization name="check_localization"/>
        <RequestPath name="request_path"/>
        <WaitForPath name="wait_path" timeout="30"/>
        <FollowPath name="follow_path"/>
        <WaitArrival name="wait_arrival" distance="0.25" timeout="60"/>
        <Dwell name="dwell_at_goal" seconds="1.0"/>
        <Stop name="stop_after_success"/>
      </Sequence>
      <Sequence name="cancel">
        <IsCancelled name="cancelled"/>
        <CancelStop name="cancel_current"/>
      </Sequence>
      <Recovery name="recovery_on_failure"/>
    </Fallback>
  </BehaviorTree>
</root>
