<launch>
  <!-- Console BT stack: Nav2-style orchestration tree + ROS-level goal gate.
       BT publishes /v8/bt/goal_request and /v8/bt/lease; the gate forwards a
       request only while the lease is fresh and the callerid is allowed.

       ★边界（2026-11-23 实测，勿按旧说法理解）★
       本 gate 的输出 /v8/3d/global/goal 在**当前四条启动方式下都没有订阅者**：
       3D 链的执行目标由 path_goal（传统）或 bt.out_goal（graph/support）直接写
       /v8/local/goal，不经过 gate；graph 装配里根本不启动本节点。
       gate 保留的原因不是"它守住了执行"，而是 real_preflight 的 REQUIRED_NODES
       把 v8_goal_gate 列为真机 SCAN 链的节点契约。
       真正的执行边界是：local 的源时效/取消检查 + safety mux 的速度仲裁；
       callerid 白名单只是可伪造的软过滤，不等于身份认证。
       若将来把 gate 输出接入执行链，必须同步改写本段与测试 test_graph_wiring。

       Profiles: `profile:=demo` loads config/bt_console_demo.yaml (the previous
       hard-coded defaults, unchanged).  `profile:=real` requires
       config/bt_console_real.yaml to exist; only the .yaml.template is shipped,
       so a real run without a copied+confirmed profile fails closed instead of
       silently using demo topics. -->
  <arg name="tree_file" default="$(find lite3_bt)/trees/navigate_with_planner.xml"/>
  <arg name="profile" default="demo"/>
  <arg name="request_topic" default="/v8/bt/goal_request"/>
  <arg name="planner_goal_topic" default="/v8/global/goal"/>
  <arg name="path_status_topic" default="/global_path/status"/>
  <arg name="path_topic" default="/global_path"/>
  <!-- Arrival budget scaling: WaitArrival keeps its tree timeout as the floor
       and extends it to path_length / speed_floor.  0.02 m/s is a stalled-run
       floor, not a target speed: the ramp polyline (10.0 m incl. step
       verticals) took 141 s wall on 2026-11-12 at RTF~0.45 (0.071 m/s), so
       0.02 gives ~502 s there while 2 m flat goals stay near the 60 s tree
       value.  Set 0 to disable scaling. -->
  <arg name="arrival_speed_floor_mps" default="0.02"/>
  <!-- Optional external arrival owner (std_msgs/Bool), e.g. SCAN's
       /lite3/scan/arrived.  Empty keeps pose-based arrival.  Mutually
       exclusive with planner_result_topic. -->
  <arg name="arrival_topic" default=""/>
  <arg name="lease_topic" default="/v8/bt/lease"/>
  <!-- Groot2 ZMQ ports.  Override when a second instance runs on the same
       host (previous hard-coded 5555/5556 made it die on bind). -->
  <arg name="zmq_pub_port" default="5555"/>
  <arg name="zmq_sub_port" default="5556"/>

  <node pkg="lite3_bt" type="bt_console" name="bt_console" output="screen">
    <!-- Inside <node>, rosparam's default namespace is the node's private one
         (/bt_console); adding ns= would nest it again. -->
    <rosparam command="load" file="$(find lite3_bt)/config/bt_console_$(arg profile).yaml"/>
    <param name="tree_file" value="$(arg tree_file)"/>
    <param name="out_goal_topic" value="$(arg request_topic)"/>
    <param name="planner_goal_topic" value="$(arg planner_goal_topic)"/>
    <param name="path_status_topic" value="$(arg path_status_topic)"/>
    <param name="path_topic" value="$(arg path_topic)"/>
    <param name="arrival_speed_floor_mps" value="$(arg arrival_speed_floor_mps)"/>
    <param name="arrival_topic" value="$(arg arrival_topic)"/>
    <param name="lease_topic" value="$(arg lease_topic)"/>
    <param name="zmq_pub_port" value="$(arg zmq_pub_port)"/>
    <param name="zmq_sub_port" value="$(arg zmq_sub_port)"/>
  </node>

  <node pkg="lite3_bt" type="goal_gate.py" name="v8_goal_gate" output="screen">
    <param name="request_topic" value="$(arg request_topic)"/>
    <param name="lease_topic" value="$(arg lease_topic)"/>
    <param name="output_topic" value="/v8/3d/global/goal"/>
    <param name="lease_timeout" value="1.0"/>
    <param name="require_lease" value="true"/>
    <!-- Demo-plane writer ownership: only bt_console may publish a goal
         request.  ROS1 callerid is spoofable, so this is NOT authentication. -->
    <param name="allowed_callers" value="/bt_console"/>
    <param name="require_acl" value="true"/>
  </node>
</launch>
