<launch>
  <!-- FAR 全局后端（第三方 overlay 版，T-20261122-02 R4②）。

       上游 MichaelFYang/far_planner @ melodic-noetic（固定 sha 2799b696），按 overlay 部署在
       /home/jack/far_overlay，不进本仓 catkin 闭包。本文件是它与 v8 契约之间的唯一接缝：
       上游只认 /odom_world、/terrain_cloud、/scan_cloud、/goal_point、/way_point、
       /far_reach_goal_status 六个绝对话题，语义地形与两点路径都由 run_global_far.py 转。

       ★ 端口话题的 arg 默认值必须与 manifest_global_far.json 的 port topic 逐字相同 ★
       v8 framework 对 launch.kind=include 的实例**不生成 remap**（render.py 的 include 分支
       直接 continue），所以两侧一旦漂移，check 仍然绿而链路其实已经断了。改话题必须两处同改。

       ★ far_planner 节点名不能改 ★
       上游把参数前缀硬编码成 /far_planner/（far_planner.cpp:417 的 master_prefix），
       改名或加 namespace 会让它把所有参数读成默认值，而默认值里 is_multi_layer=false。 -->

  <!-- 1) 端口话题（＝manifest ports，逐字） -->
  <arg name="cloud_topic" default="/rslidar_points"/>
  <arg name="start_topic" default="/v8/local/pose"/>
  <arg name="goal_topic" default="/v8/global/goal"/>
  <arg name="path_topic" default="/global_path"/>
  <arg name="status_topic" default="/global_path/status"/>
  <!-- ★ 步态路径是 manifest 端口表之外的一条线 ★
       /global_path 只放两点（末点＝FAR 航点本身），步态规划器要的前视延长点单独走这条。
       两条路径不能合并：path_goal_node 取 poses[-1] 当局部目标，延长点混进去就把目标推到航点之外。
       framework 的端口模型里没有它，check 不会替我们守这条线，改话题必须与 graph 侧的
       gait_guard.params.path_topic 同改（graph_3d_lite3_far.yaml）。 -->
  <arg name="gait_path_topic" default="/v8/gait_guard/path"/>

  <!-- 2) 规划参数（这些名字同时是 graph 侧 global.params 的键：
          include 会把实例 params 当 <arg> 传进来，键名对不上就直接报 unused arg） -->
  <arg name="world_frame" default="map"/>
  <arg name="is_multi_layer" default="true"/>
  <!-- ★ 这个参数是「odom 原点离地高」，不是「雷达安装高」★ 填错会让整条链静默失效。

       上游在 MapHandler::TraversableAnalysis（map_handler.cpp:459 附近）启动地形连通搜索时，
       只接受满足 |terrain_h - robot.z + vehicle_height| <= height_voxel_dim（0.3 m）的地形格，
       而这个格正是机器人脚下那格。本栈 /v8/local/pose 的 z 与地面同高（base_link 落在地面），
       所以 robot.z - terrain_h 恒为 0，vehicle_height 必须也是 0；填 0.436 时该差恒等于 0.436 > 0.3，
       地形图永远不初始化，紧接着 UpdateTerrainHeightGrid 末尾的 ObsNeighborCloudWithTerrain
       会把全部可见障碍格滤掉（surround_obs 归零），可见图永远不建、WAYPOINTS 恒 0。
       实证：同一帧真实点云、同一位姿，只改此参数 0.436→0.0，surround_obs 0→131、航点 0→49。 -->
  <arg name="vehicle_height" default="0.0"/>
  <arg name="terrain_free_Z" default="0.2"/>
  <arg name="lookahead_m" default="1.5"/>

  <!-- 3) 非端口参数 -->
  <arg name="config" default="default"/>
  <!-- 诊断开关：上游只在 is_debug_output 为真时才打印图顶点数、拒因等；平时关掉免得刷屏。 -->
  <arg name="debug_output" default="false"/>
  <!-- 2026-11-25：目标"就近吸附"半径。上游默认 2.0 m 是面向大场景的；本仓库验收走廊只有 1.3 m，
       默认值会让 FAR 认为目标"已在手边"而不规划（表现为 BT 等 30 s 超时、车不动）。
       这里暴露成 arg，由图按场景给值，默认仍保持上游 2.0。 -->
  <arg name="goal_adjust_radius" default="2.0"/>
  <!-- 到达判据出口：BT 侧 arrival_topic 指同一个话题。空则不发，BT 退回自己的 xy 判据。
       判据由适配器自己算：|pose−goal|_3d ≤ hypot(arrival_r_xy, arrival_z_tol)。
       r_xy 对齐 BT 树 WaitArrival 的 0.25，z_tol 是竖向容差（验收 3 的偏置标定写回这里）。 -->
  <arg name="arrival_topic" default="/v8/bt/arrived"/>
  <arg name="arrival_r_xy" default="0.25"/>
  <arg name="arrival_z_tol" default="0.30"/>
  <arg name="waypoint_timeout_s" default="10.0"/>
  <arg name="terrain_range_m" default="15.0"/>
  <arg name="terrain_rate_hz" default="2.5"/>
  <arg name="terrain_flatten" default="true"/>

  <!-- 4) 上游主节点。不复用上游 far_planner.launch：它连带起 rviz 与 graph_decoder，
          两者都不在最小包集里。 -->
  <node pkg="far_planner" type="far_planner" name="far_planner" output="screen">
    <rosparam command="load" file="$(find far_planner)/config/$(arg config).yaml"/>
    <!-- 三处必须覆盖上游默认值，写在 load 之后才生效 -->
    <param name="world_frame" value="$(arg world_frame)"/>
    <param name="is_multi_layer" value="$(arg is_multi_layer)"/>
    <param name="vehicle_height" value="$(arg vehicle_height)"/>
    <param name="Util/terrain_free_Z" value="$(arg terrain_free_Z)"/>
    <param name="is_debug_output" value="$(arg debug_output)"/>
    <param name="GPlanner/goal_adjust_radius" value="$(arg goal_adjust_radius)"/>
  </node>

  <!-- 5) v8 侧适配器：语义地形、两点/带前视的步态路径、取消写者、3D 到达判据。 -->
  <node pkg="v8_platform" type="run_global_far.py" name="v8_global_far" output="screen">
    <param name="world_frame" value="$(arg world_frame)"/>
    <param name="cloud_topic" value="$(arg cloud_topic)"/>
    <param name="start_topic" value="$(arg start_topic)"/>
    <param name="goal_topic" value="$(arg goal_topic)"/>
    <param name="path_topic" value="$(arg path_topic)"/>
    <param name="gait_path_topic" value="$(arg gait_path_topic)"/>
    <param name="status_topic" value="$(arg status_topic)"/>
    <param name="lookahead_m" value="$(arg lookahead_m)"/>
    <param name="arrival_topic" value="$(arg arrival_topic)"/>
    <param name="arrival_r_xy" value="$(arg arrival_r_xy)"/>
    <param name="arrival_z_tol" value="$(arg arrival_z_tol)"/>
    <param name="waypoint_timeout_s" value="$(arg waypoint_timeout_s)"/>
    <param name="terrain_range_m" value="$(arg terrain_range_m)"/>
    <param name="terrain_rate_hz" value="$(arg terrain_rate_hz)"/>
    <param name="terrain_flatten" value="$(arg terrain_flatten)"/>
  </node>
</launch>
