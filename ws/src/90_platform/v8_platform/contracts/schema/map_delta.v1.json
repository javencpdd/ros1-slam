{
 "title": "map_delta/v1",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema_version", "map_id", "base_version", "delta_id", "source", "ops"],
 "properties": {
  "schema_version": {"const": 1},
  "map_id": {"type": "string", "minLength": 1},
  "base_version": {"type": "integer", "minimum": 1},
  "delta_id": {"type": "string", "minLength": 1},
  "source": {
   "type": "object", "additionalProperties": false, "required": ["uri", "sha256"],
   "properties": {"uri": {"type": "string", "minLength": 1},
                  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
  "ops": {
   "type": "array", "minItems": 1,
   "items": {
    "type": "object", "additionalProperties": false, "required": ["op"],
    "properties": {"op": {"enum": ["upsert_surface", "remove_surface"]},
                   "surface_id": {"type": "string", "minLength": 1},
                   "surface": {"type": "object"}}}}
 }
}
