{
 "schema_version": 2,
 "id": "v8.fw.hdl_nodelet_group",
 "version": "0.1.0",
 "roles": [
  "global_localization",
  "odometry"
 ],
 "dimensions": 3,
 "capability": {
  "kinematics": "not_applicable",
  "cancellation": "none",
  "supports_dynamic_obstacles": false
 },
 "ownership": {
  "tf_edges": [
   {
    "parent": "map",
    "child": "base_link"
   }
  ],
  "command_topics": [],
  "namespace": "/",
  "stop": "process_group_signal"
 },
 "launch": {
  "kind": "nodelet_group",
  "package": "nodelet",
  "manager": "hdl_manager",
  "plugins": [
   {
    "type": "hdl_localization/GlobalmapServerNodelet",
    "name": "globalmap_server_nodelet",
    "params": {
     "globalmap_pcd": "/repo/data/maps/lite3.pcd",
     "convert_utm_to_local": true,
     "downsample_resolution": 0.1
    }
   },
   {
    "type": "hdl_localization/HdlLocalizationNodelet",
    "name": "hdl_localization_nodelet",
    "params": {
     "lidar_timeout_ms": 9999,
     "odom_child_frame_id": "base_link",
     "use_imu": true,
     "imu_timeout_ms": 9999,
     "invert_acc": false,
     "invert_gyro": false,
     "cool_time_duration": 2.0,
     "enable_robot_odometry_prediction": false,
     "robot_odom_frame_id": "odom",
     "reg_method": "NDT_OMP",
     "ndt_neighbor_search_method": "DIRECT1",
     "ndt_neighbor_search_radius": 3.0,
     "ndt_resolution": 2.0,
     "downsample_resolution": 1.0,
     "specify_init_pose": true,
     "init_pos_x": 0.0,
     "init_pos_y": 0.0,
     "init_pos_z": 0.0,
     "init_ori_w": 1.0,
     "init_ori_x": 0.0,
     "init_ori_y": 0.0,
     "init_ori_z": 0.0,
     "use_global_localization": false
    }
   }
  ]
 },
 "ports": {
  "inputs": [
   {
    "name": "points",
    "type": "sensor_msgs/PointCloud2",
    "required": false,
    "topic": "/velodyne_points"
   },
   {
    "name": "imu",
    "type": "sensor_msgs/Imu",
    "required": false,
    "topic": "/gpsimu_driver/imu_data"
   }
  ],
  "outputs": [
   {
    "name": "odom",
    "type": "nav_msgs/Odometry",
    "topic": "/odom"
   }
  ]
 },
 "evidence": {
  "level": "declared",
  "reports": []
 }
}
