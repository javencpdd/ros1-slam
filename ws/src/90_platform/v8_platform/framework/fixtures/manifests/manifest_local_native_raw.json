{
 "schema_version": 3,
 "id": "v8.fw.local_native_raw",
 "version": "0.1.0",
 "roles": [
  "local_planner",
  "controller"
 ],
 "dimensions": 3,
 "capability": {
  "kinematics": "quadruped_kinematic",
  "cancellation": "none",
  "supports_dynamic_obstacles": true
 },
 "ownership": {
  "tf_edges": [],
  "command_topics": [
   "/v8/local/cmd_vel_3d",
   "/cmd_vel_raw"
  ],
  "namespace": "/",
  "stop": "process_group_signal"
 },
 "launch": {
  "kind": "node",
  "package": "v8_platform",
  "type": "local_planner/ros_node.py"
 },
 "ports": {
  "inputs": [
   {
    "name": "map",
    "type": "std_msgs/String",
    "schema": "support_map/v1",
    "topic": "/v8_support_map"
   },
   {
    "name": "pose",
    "type": "geometry_msgs/PoseStamped",
    "topic": "/v8/local/pose"
   },
   {
    "name": "goal",
    "type": "geometry_msgs/PoseStamped",
    "topic": "/v8/local/goal"
   },
   {
    "name": "obstacles",
    "type": "std_msgs/String",
    "topic": "/v8/local/obstacles"
   },
   {
    "name": "localization",
    "type": "std_msgs/Bool",
    "topic": "/v8/local/localization_ok"
   }
  ],
  "outputs": [
   {
    "name": "cmd",
    "type": "geometry_msgs/TwistStamped",
    "topic": "/v8/local/cmd_vel_3d"
   },
   {
    "name": "trajectory",
    "type": "std_msgs/String",
    "topic": "/v8/local/trajectory"
   },
   {
    "name": "status",
    "type": "std_msgs/String",
    "topic": "/v8/local/status"
   },
   {
    "name": "cmd_twist",
    "type": "geometry_msgs/Twist",
    "topic": "/cmd_vel_raw",
    "command_topic": "/cmd_vel_raw"
   }
  ]
 },
 "evidence": {
  "level": "declared",
  "reports": []
 },
 "execution": {
  "modes": [
   "real_robot"
  ],
  "robot_id": "lite3"
 }
}
