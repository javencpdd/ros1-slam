{
 "schema_version": 2,
 "id": "v8.fw.global3d_topic",
 "version": "0.1.0",
 "roles": [
  "global_planner"
 ],
 "dimensions": 3,
 "capability": {
  "kinematics": "not_applicable",
  "cancellation": "cooperative",
  "supports_dynamic_obstacles": false
 },
 "ownership": {
  "tf_edges": [],
  "command_topics": [],
  "namespace": "/",
  "stop": "process_group_signal"
 },
 "launch": {
  "kind": "node",
  "package": "v8_platform",
  "type": "planner/topic_node.py"
 },
 "ports": {
  "inputs": [
   {
    "name": "map",
    "type": "std_msgs/String",
    "schema": "support_map/v1",
    "topic": "/v8_support_map"
   },
   {
    "name": "start",
    "type": "geometry_msgs/PoseStamped",
    "topic": "/v8/global/start"
   },
   {
    "name": "goal",
    "type": "geometry_msgs/PoseStamped",
    "topic": "/v8/global/goal"
   }
  ],
  "outputs": [
   {
    "name": "path",
    "type": "nav_msgs/Path",
    "topic": "/global_path"
   },
   {
    "name": "status",
    "type": "std_msgs/String",
    "topic": "/global_path/status"
   }
  ]
 },
 "evidence": {
  "level": "declared",
  "reports": []
 }
}
