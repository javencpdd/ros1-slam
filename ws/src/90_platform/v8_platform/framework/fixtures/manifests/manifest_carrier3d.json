{
 "schema_version": 3,
 "id": "v8.fw.carrier3d",
 "version": "0.1.0",
 "roles": [
  "middleware"
 ],
 "dimensions": 3,
 "capability": {
  "kinematics": "quadruped_kinematic",
  "cancellation": "none",
  "supports_dynamic_obstacles": false
 },
 "ownership": {
  "tf_edges": [],
  "command_topics": [],
  "namespace": "/",
  "stop": "process_group_signal"
 },
 "launch": {
  "kind": "node",
  "package": "v8_platform",
  "type": "local_planner/kinematic3d_node.py"
 },
 "ports": {
  "inputs": [
   {
    "name": "cmd",
    "type": "geometry_msgs/Twist",
    "topic": "/cmd_vel"
   },
   {
    "name": "map",
    "type": "std_msgs/String",
    "schema": "support_map/v1",
    "topic": "/v8_support_map"
   }
  ],
  "outputs": [
   {
    "name": "pose",
    "type": "geometry_msgs/PoseStamped",
    "topic": "/v8/local/pose"
   },
   {
    "name": "localization",
    "type": "std_msgs/Bool",
    "topic": "/v8/local/localization_ok"
   },
   {
    "name": "status",
    "type": "std_msgs/String",
    "topic": "/v8/3d/carrier/status"
   }
  ]
 },
 "evidence": {
  "level": "declared",
  "reports": []
 },
 "execution": {
  "modes": [
   "simulation"
  ],
  "robot_id": null
 }
}
