{
  "schema_version": 3,
  "id": "v8.fw.lio_gate",
  "version": "0.1.0",
  "roles": [
    "odometry"
  ],
  "dimensions": 3,
  "capability": {
    "kinematics": "not_applicable",
    "cancellation": "none",
    "supports_dynamic_obstacles": false
  },
  "ownership": {
    "tf_edges": [
      {
        "parent": "camera_init",
        "child": "body"
      }
    ],
    "command_topics": [],
    "namespace": "/",
    "stop": "process_group_signal"
  },
  "launch": {
    "kind": "node",
    "package": "v8_platform",
    "type": "run_gate_relay.py"
  },
  "ports": {
    "inputs": [
      {
        "name": "in",
        "topic": "/Odometry",
        "type": "nav_msgs/Odometry",
        "required": false
      }
    ],
    "outputs": [
      {
        "name": "out",
        "topic": "/Odometry_gated",
        "type": "nav_msgs/Odometry"
      }
    ]
  },
  "evidence": {
    "level": "declared",
    "reports": []
  },
  "execution": {
    "modes": [
      "simulation"
    ],
    "robot_id": null,
    "selectors": [
      {
        "name": "source",
        "default": "sim_gt",
        "values": [
          "sim_gt",
          "faster_lio",
          "ndt"
        ]
      }
    ]
  }
}
