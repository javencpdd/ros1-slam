{
 "schema_version": 2,
 "id": "v8.boundary.adapter",
 "version": "0.1.0",
 "roles": [
  "robot_adapter",
  "middleware"
 ],
 "dimensions": 3,
 "capability": {
  "kinematics": "not_applicable",
  "cancellation": "cooperative",
  "supports_dynamic_obstacles": false
 },
 "ownership": {
  "tf_edges": [],
  "command_topics": [],
  "namespace": "/",
  "stop": "process_group_signal"
 },
 "launch": {
  "kind": "node",
  "package": "v8_platform",
  "type": "boundary/ros_bridge.py"
 },
 "ports": {
  "inputs": [
   {
    "name": "cmd",
    "type": "geometry_msgs/Twist",
    "topic": "/cmd_vel"
   }
  ],
  "outputs": [
   {
    "name": "odom",
    "type": "nav_msgs/Odometry",
    "topic": "/boundary/odom"
   },
   {
    "name": "imu",
    "type": "sensor_msgs/Imu",
    "topic": "/boundary/imu"
   },
   {
    "name": "joint",
    "type": "sensor_msgs/JointState",
    "topic": "/boundary/joint_states"
   },
   {
    "name": "status",
    "type": "std_msgs/String",
    "topic": "/boundary/status"
   }
  ]
 },
 "evidence": {
  "level": "declared",
  "reports": []
 }
}
