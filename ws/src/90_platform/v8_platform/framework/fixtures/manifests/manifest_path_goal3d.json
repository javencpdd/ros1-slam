{
 "schema_version": 3,
 "id": "v8.fw.path_goal3d",
 "version": "0.1.0",
 "roles": [
  "middleware"
 ],
 "dimensions": 3,
 "capability": {
  "kinematics": "not_applicable",
  "cancellation": "none",
  "supports_dynamic_obstacles": false
 },
 "ownership": {
  "tf_edges": [],
  "command_topics": [],
  "namespace": "/",
  "stop": "process_group_signal"
 },
 "launch": {
  "kind": "node",
  "package": "v8_platform",
  "type": "local_planner/path_goal_node.py"
 },
 "ports": {
  "inputs": [
   {
    "name": "path",
    "type": "nav_msgs/Path",
    "topic": "/v8/3d/global/path"
   }
  ],
  "outputs": [
   {
    "name": "goal",
    "type": "geometry_msgs/PoseStamped",
    "topic": "/v8/local/goal"
   },
   {
    "name": "status",
    "type": "std_msgs/String",
    "topic": "/v8/3d/path_goal/status"
   }
  ]
 },
 "evidence": {
  "level": "declared",
  "reports": []
 },
 "execution": {
  "modes": [
   "simulation",
   "real_robot"
  ],
  "robot_id": null
 }
}
