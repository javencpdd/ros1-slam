Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 90; 90; 90
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Show Names: true
    - Class: rviz/MarkerArray
      Enabled: true
      Name: SupportMapAndPlans
      Topic: /v8/3d/viz/markers
      Queue Size: 5
    - Class: rviz/Path
      Enabled: true
      Name: GlobalPath
      Topic: /v8/3d/global/path
      Color: 25; 204; 242
    - Class: rviz/Path
      Enabled: true
      Name: LocalPath
      Topic: /v8/3d/viz/local_path
      Color: 242; 140; 25
  Enabled: true
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/PublishPoint
      Topic: /clicked_point
    - Class: rviz/SetInitialPose
      Topic: /initialpose
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Pitch: 0.5
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
