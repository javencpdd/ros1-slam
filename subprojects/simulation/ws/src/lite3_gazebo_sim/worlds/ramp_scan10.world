<?xml version="1.0" ?>
<!--
  ramp_scan.world —— SCAN P4 斜坡场景（2026-11-12，v2 坡顶在原点）
  · v1 把坡顶放在 x=5.5，机器人出生点与 LIO 原点不重合，P4 的轨迹坐标（LIO 系）
    直接当 world 用会把注入箱/目标送到世界外（2026-11-12 实测）。v2 把坡顶平台
    放在原点：机器人出生 (0,0)，LIO 原点≈world 原点（仅 z 差 0.88m），注入坐标
    的 x/y 与 world 一致，z 由 P4_INJECT_Z 给定。
  · 平滑 10° 下坡（与 v8 ramp_nav 的 8.53° 同量级；SCAN 需参考路径模式 +
    地面过滤 + 0.25m 侧偏箱体才可规划/避障，见 note/进度 记录）：平台
    x∈[-0.56,0.64]（顶面 z=0.73）→ 坡面 x=-0.53→-4.73（z 0.73→0），
    坡底接地面；两侧墙/后墙给特征。
  · obs_5 静态 0.8³ 箱，P4 运行时搬到坡面轨迹前方，跑完还原。
-->
<sdf version="1.6">
  <world name="ramp_scan">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
      <max_contacts>20</max_contacts>
      <ode>
        <solver><type>quick</type><iters>50</iters><sor>1.3</sor></solver>
        <constraints><cfm>0.0</cfm><erp>0.2</erp></constraints>
      </ode>
    </physics>
    <plugin name="gazebo_ros_init" filename="libgazebo_ros_init.so"/>
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- 坡顶平台：顶面 z=0.73，x∈[-0.56,0.64] -->
    <model name="platform">
      <static>true</static>
      <pose>0.04 0 0.63 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 3.0 0.2</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="vis"><geometry><box><size>1.2 3.0 0.2</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient></material></visual>
      </link>
    </model>

    <!-- 10° 下坡：box 4.2x3.0x0.2，pitch=-10°，顶面高边 (-0.56,0.73)、低边 (-4.7,0) -->
    <model name="ramp">
      <static>true</static>
      <pose>-2.624 0 0.266 0 -0.174533 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>4.2 3.0 0.2</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>4.2 3.0 0.2</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- 边界墙 -->
    <model name="wall_north">
      <static>true</static>
      <pose>-2.0 1.8 0.75 0 0 0</pose>
      <link name="link"><collision name="col"><geometry><box><size>8.4 0.1 1.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8.4 0.1 1.5</size></box></geometry></visual></link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>-2.0 -1.8 0.75 0 0 0</pose>
      <link name="link"><collision name="col"><geometry><box><size>8.4 0.1 1.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8.4 0.1 1.5</size></box></geometry></visual></link>
    </model>
    <model name="wall_back">
      <static>true</static>
      <pose>-5.4 0 0.75 0 0 0</pose>
      <link name="link"><collision name="col"><geometry><box><size>0.1 3.7 1.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 3.7 1.5</size></box></geometry></visual></link>
    </model>
    <model name="wall_front">
      <static>true</static>
      <pose>1.0 0 0.75 0 0 0</pose>
      <link name="link"><collision name="col"><geometry><box><size>0.1 3.7 1.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 3.7 1.5</size></box></geometry></visual></link>
    </model>

    <!-- P4 注入箱：0.8³，原始位姿在平台侧后方（运行时搬到轨迹前方） -->
    <model name="obs_5">
      <static>true</static>
      <pose>0.9 -1.2 1.13 0 0 -0.6</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material><ambient>0.8 0.3 0.6 1</ambient></material></visual>
      </link>
    </model>
  </world>
</sdf>
