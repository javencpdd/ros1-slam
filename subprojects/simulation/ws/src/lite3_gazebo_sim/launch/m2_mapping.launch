<launch>
  <!-- m2_mapping.launch —— faster_lio sim 变体（小张 payload，2026-10-06）：m1_mapping.launch 同构 + pcd_save 开关。
       契约零改动：C16 yaml 原值装载（lid_topic/imu_topic/lidar_type 不触碰）；运行期覆盖 use_sim_time=true。
       pcd_save:=true 仅 M2-3 建图阶段使用（D-04 红线：跑判据一律 false；起前备份/退后核 sha256 由 m2_smoke 兜底）。
       优雅停机（SIGINT）后 faster_lio 落盘 data/maps/lite3.pcd，m2_smoke 负责转存 sim_venue.pcd 并恢复样张。 -->
  <arg name="pcd_save" default="false"/>
  <rosparam command="load" file="$(find lite3_slam)/config/faster_lio_outdoor.yaml"/>
  <param name="use_sim_time" value="true"/>
  <param name="pcd_save/pcd_save_en" value="$(arg pcd_save)"/>
  <!-- Raw LIO TF is not a production edge. The graph-owned lio_gate republishes
       camera_init->body from /Odometry_gated, so disabling the gate also freezes
       production TF instead of letting raw LIO bypass it. -->
  <param name="/publish/tf_imu_frame" value="lio_body_raw"/>

  <!-- ★map←camera_init 静态锚点★（2026-11-27 补）：faster_lio 的世界系是 camera_init（取首帧位姿为原点），
       而 v8 的 loc 节点按 `frame: map` 工作、每条 /Odometry 都要查 map←camera_init；
       不给这条 TF 时回调每帧抛异常（localization_node.py:94/102），/v8/local/pose 无输出、编排只起 6/10。
       语义＝"LIO 的世界原点就是机器人在 map 里的出生位姿"，所以平移取 spawn、yaw 取 spawn_yaw，
       **由调用方按实际放置点传参**，不在代码里写死。 -->
  <arg name="map_spawn_x" default="0"/>
  <arg name="map_spawn_y" default="0"/>
  <arg name="map_spawn_z" default="0.45"/>
  <arg name="map_spawn_roll" default="0"/>
  <arg name="map_spawn_pitch" default="0.2617993877991494"/>
  <arg name="map_spawn_yaw" default="0"/>
  <!-- T1: camera_init is the first Faster-LIO body frame, not a gravity-levelled
       frame. In this URDF body is the rslidar frame pitched +15 deg, so the map
       anchor must carry that attitude as well as z=0.45 (lidar height). -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_lio_world"
        args="$(arg map_spawn_x) $(arg map_spawn_y) $(arg map_spawn_z) $(arg map_spawn_yaw) $(arg map_spawn_pitch) $(arg map_spawn_roll) map camera_init"/>
  <!-- GT isolation is explicit. Historical callers keep GT on odom/base_link;
       isolated acceptance runs pass isolate_gt:=true plus gt_* frames in m2_gazebo. -->
  <arg name="isolate_gt" default="false"/>
  <node if="$(arg isolate_gt)" pkg="tf2_ros" type="static_transform_publisher" name="body_to_base_link"
        args="0.08799 0 -0.328415 0 -0.2617993877991494 0 body base_link"/>
  <node unless="$(arg isolate_gt)" pkg="tf2_ros" type="static_transform_publisher" name="map_to_odom_compat"
        args="0 0 0 0 0 0 map odom"/>
  <!-- In non-isolated mode the legacy map->odom identity keeps the GT chain
       connected for historical callers. In isolated mode the estimated chain is
       map->camera_init->body->base_link, and GT lives under gt_odom->gt_base. -->
  <node pkg="faster_lio" type="run_mapping_online" name="faster_lio_online" output="screen"/>
</launch>
