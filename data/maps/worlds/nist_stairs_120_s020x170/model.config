<?xml version="1.0"?>
<model>
  <name>NIST stairs 120 scaled 0.51/1.70</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>Stefan Kohlbrecher</name>
    <email>kohlbrecher@sim.tu-darmstadt.de</email>
  </author>

  <description>
    OpenRobotics NIST stairs 120 (CC0, Gazebo Fuel), scaled in place:
    x/y x1.70 and z x0.51. The mesh top faces then match the derived
    support map nist_stairs_120_s020x170_support.json (5 levels,
    0.1988..0.8904 m, 0.720 m tread). The mesh bottom floats ~0.173 m
    above z=0 (same asset property as the unscaled model).
  </description>
</model>
