note/**/证据/*密码*

# ---- 用户/会话私有 ----
.ssh/
.cache/
.config/
.ros/
.bash_history
.bash_logout
.xsessionrc
.profile
Desktop/

# ---- 编辑器/系统杂项 ----
*.swp
*~
