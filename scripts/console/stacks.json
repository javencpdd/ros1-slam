{
  "comment": "网页任务台可启停的白名单。网页只能按 name 调这里列出的命令，不能传命令行。可选 local_only=true 的栈只允许本机 agent 启停（远程返回 403）。",
  "stacks": [
    {
      "name": "sim_m1",
      "label": "m1 Gazebo（仿真台）",
      "category": "demo",
      "container": "ros1-slam-sim-viz",
      "master": "http://roscore:11312",
      "world": "m1_world.world",
      "cmd": "roslaunch lite3_gazebo_sim m1_gazebo.launch gui:=false",
      "cmd_template": "roslaunch lite3_gazebo_sim m1_gazebo.launch gui:=false world:=/opt/ros1-slam/ws/src/95_simulation/lite3_gazebo_sim/{world}",
      "world_choices": [
        {"file": "m1_world.world", "path": "worlds/m1_world.world", "label": "m1 世界（稀障平地）"},
        {"file": "m1_world_v2.world", "path": "worlds/m1_world_v2.world", "label": "m1_world_v2"},
        {"file": "demo_two_floor.world", "path": "worlds/demo_two_floor.world", "label": "两层 demo（demo_two_floor，SLAM）"},
        {"file": "open.world", "path": "scenarios/two_floor_nav/worlds/open.world", "label": "two_floor_nav open（几何，非 app）"}
      ],
      "world_stack": true,
      "description": "m1 Gazebo + lite3_planar + sim_adapter；world 可选，headless，给建图/监控页提供话题。",
      "stop_timeout": 15,
      "notes": "demo 栈；不启真机、不写正式判据。同一时间只起一个 Gazebo world；换 world 先停当前栈。启动后 /clock、/rslidar_points、/livox/imu 应出现。"
    },
    {
      "name": "mapping_m1",
      "label": "m1 建图（faster-lio）",
      "category": "demo",
      "container": "ros1-slam-sim-viz",
      "master": "http://roscore:11312",
      "world": "m1_world.world",
      "cmd": "roslaunch lite3_gazebo_sim m1_mapping.launch",
      "description": "在 m1 Gazebo 上跑 faster_lio；m1_mapping.launch 已关 pcd_save（GAP-5 红线）。",
      "requires": ["sim_m1"],
      "stop_timeout": 20,
      "notes": "先起 sim_m1；这是 demo 建图，不代替 formal/LIO 验收。"
    },
    {
      "name": "mapping_save",
      "label": "m1 建图并保存（faster-lio）",
      "category": "demo",
      "container": "ros1-slam-sim-viz",
      "master": "http://roscore:11312",
      "world": "m1_world.world",
      "cmd": "roslaunch lite3_gazebo_sim m2_mapping.launch pcd_save:=true",
      "requires": ["sim_m1"],
      "stop_timeout": 30,
      "save_map": "data/maps/lite3.pcd",
      "description": "在 m1 Gazebo 上跑 faster_lio，停止时把 PCD 保存到 data/maps/imported/ 并刷新地图库。",
      "notes": "GAP-5：agent 起前备份样张、停后恢复并转存；只允许 demo 使用。"
    },
    {
      "name": "stairstudy",
      "label": "stairstudy 场景（可视化）",
      "category": "demo",
      "container": "ros1-slam-sim-viz",
      "master": "http://roscore:11312",
      "world": "stair_lab_stairs_easy.world",
      "cmd": "roslaunch lite3_gazebo_sim stairstudy.launch world_file:=stair_lab_stairs_easy.world",
      "cmd_template": "roslaunch lite3_gazebo_sim stairstudy.launch world_file:={world}",
      "world_choices": [
        {"file": "stair_lab_stairs_easy.world", "label": "stairs_easy（13 级 6 cm）"},
        {"file": "stair_lab_stairs_mid.world", "label": "stairs_mid"},
        {"file": "stair_lab_stairs_steep.world", "label": "stairs_steep"},
        {"file": "stair_lab_stairs_blocked_mid.world", "label": "stairs_blocked_mid"},
        {"file": "stair_lab_wall_h045.world", "label": "wall_h045"},
        {"file": "stair_lab_wall_h080.world", "label": "wall_h080"},
        {"file": "stair_lab_ramp_envelope.world", "label": "ramp_envelope"},
        {"file": "stair_lab_sidewall_envelope.world", "label": "sidewall_envelope"},
        {"file": "stair_lab_blank.world", "label": "blank（仅地面/太阳）"}
      ],
      "world_stack": true,
      "description": "stair_lab 世界可选 + 白盒载体；只做感知/可视化，不判爬楼。",
      "stop_timeout": 20,
      "notes": "demo 可视化；正式导航判据仍用 runtime_lab/作业单。同一时间只起一个 Gazebo world；换 world 先停当前栈。"
    },
    {
      "name": "sim_nist",
      "label": "NIST 楼梯 120（仅世界）",
      "category": "demo",
      "container": "ros1-slam-sim-viz",
      "master": "http://roscore:11312",
      "world": "nist_stairs_120.world",
      "cmd": "roslaunch lite3_gazebo_sim nist_stairs_120.launch gui:=false",
      "world_stack": true,
      "description": "只起 NIST 楼梯世界 + 模型库；不含机器人、点云或导航。",
      "stop_timeout": 15,
      "notes": "world-only；看画面需本机 gzclient 或控制台实体世界（nist_stairs_120）。同一时间只起一个 Gazebo world。"
    },
    {
      "name": "voxel_stream",
      "label": "服务端体素流（console）",
      "category": "demo",
      "container": "ros1-slam-sim-viz",
      "master": "http://roscore:11312",
      "world": "—",
      "cmd": "python3 /opt/ros1-slam/scripts/console/voxel_stream.py --leaf 0.10 --rate 2 --out /opt/ros1-slam/data/console/voxels",
      "description": "订阅 /cloud_registered 与 /rslidar_points，体素下采样后写 data/console/voxels/latest.bin + meta.json；控制台按二进制拉取。",
      "requires": ["sim_m1"],
      "stop_timeout": 10,
      "notes": "服务端体素；/cloud_registered 优先，1.5 s 无消息回退 /rslidar_points（传感器系）。不写正式判据。"
    }
  ]
}
